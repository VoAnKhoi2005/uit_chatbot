# ── Judge model (RAGAS) ────────────────────────────────────────────────────
# OpenAI-protocol. Unset, these fall back to the same LLM_BASE_URL/LLM_API_KEY/
# LLM_MODEL the chat backend's own generic client (backend/llm/client.py)
# uses - set JUDGE_* here only if you want the judge on a different
# model/endpoint than chat itself (e.g. a stronger judge model).
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_API_KEY=

# Fallbacks (shared with the backend's .env) if the JUDGE_* vars above are left blank.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Embedding model for RAGAS's embedding-dependent metrics (answer_relevancy).
# Defaults to the same sentence-transformers model retrieval already uses, so
# no second paid embedding API call is required.
JUDGE_EMBED_MODEL=keepitreal/vietnamese-sbert
