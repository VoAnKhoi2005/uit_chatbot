# ── Judge model (RAGAS) ────────────────────────────────────────────────────
# OpenAI-API-compatible. Defaults to Groq's endpoint, reusing the same
# GROQ_API_KEY the chatbot backend itself uses (backend/.env) if this is left
# unset here.
JUDGE_BASE_URL=https://api.groq.com/openai/v1
JUDGE_MODEL=llama-3.3-70b-versatile
JUDGE_API_KEY=
# Fallbacks read if JUDGE_API_KEY is blank - set one of these instead if you'd
# rather not duplicate the backend's key here.
GROQ_API_KEY=
OPENAI_API_KEY=

# Embedding model for RAGAS's embedding-dependent metrics (answer_relevancy).
# Defaults to the same sentence-transformers model retrieval already uses, so
# no second paid embedding API call is required.
JUDGE_EMBED_MODEL=keepitreal/vietnamese-sbert
