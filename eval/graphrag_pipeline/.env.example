# ── Backend to collect against ────────────────────────────────────────────────
# `collect` calls this over HTTP (POST /chat) - it never imports backend/
# code, so the backend just needs to be reachable here, e.g. the Docker
# Compose service (`docker compose up backend`) on its default port.
EVAL_BACKEND_URL=http://localhost:10000

# ── Judge model (RAGAS) ────────────────────────────────────────────────────
# OpenAI-protocol. Unset, these fall back to the same LLM_BASE_URL/LLM_API_KEY/
# LLM_MODEL the chat backend's own generic client (backend/llm/client.py)
# uses - set JUDGE_* here only if you want the judge on a different
# model/endpoint than chat itself (e.g. a stronger judge model).
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_API_KEY=

# Fallbacks (shared with the backend's .env) if the JUDGE_* vars above are left blank.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Embedding model for RAGAS's embedding-dependent metrics (answer_relevancy).
# Defaults to the same OpenAI-protocol embedding model/endpoint retrieval
# already uses (EMBEDDING_*/LLM_* above; default model qwen/qwen3-embedding-8b) -
# set this only to judge with a different embedding model than retrieval uses.
JUDGE_EMBED_MODEL=
