# Khởi tạo database
db = ConceptRelationDB()

# ==================== THÊM CONCEPTS ====================
print("=== THÊM CONCEPTS ===")
db.add_concept("Lập trình", "Technology")
db.add_concept("Python", "Technology")
db.add_concept("Machine Learning", "Technology")
db.add_concept("Học tập", "Education")
db.add_concept("Đi học", "Education")

# ==================== THÊM RELATIONS ====================
print("\n=== THÊM RELATIONS ===")
db.add_relation("related_to", "connection")
db.add_relation("similar_to", "connection")
db.add_relation("part_of", "hierarchy")
db.add_relation("depends_on", "hierarchy")

# ==================== LẤY DỮ LIỆU ====================
print("\n=== LẤY DỮ LIỆU ===")
print("\nTất cả concepts:")
all_concepts = db.get_all_concepts()
for c in all_concepts:
    print(f"  ID {c['id']}: {c['name']} (Parent: {c['parent_id']})")

print("\nTất cả relations:")
all_relations = db.get_all_relations()
for r in all_relations:
    print(f"  ID {r['id']}: {r['name']} (Parent: {r['parent_id']})")

# ==================== TÌM KIẾM SEMANTIC ====================
print("\n=== TÌM KIẾM SEMANTIC ===")
print("\nTìm concepts tương tự 'Lập trình Python':")
results = db.search_concepts("Lập trình Python", top_k=3)
for r in results:
    print(f"  {r['name']} - Score: {r['score']}")

print("\nTìm relations tương tự 'liên quan':")
results = db.search_relations("liên quan", top_k=3)
for r in results:
    print(f"  {r['name']} - Score: {r['score']}")

# ==================== LẤY THEO PARENT ====================
print("\n=== LẤY THEO PARENT ===")
print("\nConcepts có parent 'Technology':")
tech_concepts = db.get_concepts_by_parent("Technology")
for c in tech_concepts:
    print(f"  {c['name']}")

print("\nRelations có parent 'connection':")
connections = db.get_relations_by_parent("connection")
for r in connections:
    print(f"  {r['name']}")

# ==================== CẬP NHẬT ====================
print("\n=== CẬP NHẬT ===")
db.update_concept(1, name="Lập trình nâng cao")
db.update_relation(1, name="liên quan tới")

# ==================== THỐNG KÊ ====================
print("\n=== THỐNG KÊ ===")
stats = db.get_stats()
print(f"Concepts: {stats['concepts_count']}")
print(f"Relations: {stats['relations_count']}")

# ==================== TÌM KIẾM TẤT CẢ ====================
print("\n=== TÌM KIẾM TẤT CẢ ===")
all_results = db.search_all("Python", top_k=3)
print("\nConcepts:")
for c in all_results['concepts']:
    print(f"  {c['name']} - Score: {c['score']}")
print("\nRelations:")
for r in all_results['relations']:
    print(f"  {r['name']} - Score: {r['score']}")

# ==================== EXPORT ====================
print("\n=== EXPORT ===")
db.export_data('vector_data.json')

# ==================== XÓASIS ====================
print("\n=== XÓA ===")
db.delete_concept(5)
db.delete_relation(4)

# Đóng kết nối
db.close()