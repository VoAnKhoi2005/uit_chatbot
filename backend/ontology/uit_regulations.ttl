uit:khoan_f0ee062f_5fd3_4236_bb43_c8a8cca50a63 a uit:Clause ;
    rdfs:label "Khoản 5" ;
    uit:clauseId "f0ee062f-5fd3-4236-bb43-c8a8cca50a63" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText """Cán bộ chấm thi có trách nhiệm giải đáp mọi thắc mắc của sinh viên về điểm thi trong
thời hạn nhận đơn phúc khảo.""" ;
    uit:hasParent uit:dieu_e4691bdc_6681_48aa_9b10_9b9af5624c8d ;
    uit:inDocument uit:Document_0cf30b50_fd07_4dc5_96fe_4b701c1e54ec ;
