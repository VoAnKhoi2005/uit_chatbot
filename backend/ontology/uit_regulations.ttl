uit:khoan_6c883450_4ab5_45de_94e7_b635bb9bd67e a uit:Clause ;
    rdfs:label "Khoản 6" ;
    uit:clauseId "6c883450-4ab5-45de-94e7-b635bb9bd67e" ;
    uit:docId "c9cbb5b3-7c97-4baf-b5ce-6803d6ef5f3a" ;
    uit:docTitle "507-Qd-Dhcntt-27-5-2024 Quy Che Dao Tao Cho Sinh Vien" ;
    uit:fullText """Phòng Công tác sinh viên phối hợp với TTPTCNTT trong công tác quản lý sinh viên,
cấp thẻ sinh viên, cấp giấy xác nhận sinh viên.
Ngoài các đơn vị nói trên, các đơn vị khác trong Trường có trách nhiệm phối hợp triển khai
ĐTTX theo đúng chức năng, nhiệm vụ của đơn vị.""" ;
    uit:hasParent uit:dieu_40f4881e_5de0_4bdd_8491_ead7bc6b4a7d ;
