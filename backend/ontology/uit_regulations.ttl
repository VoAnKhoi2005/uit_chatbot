    uit:title "Khoản 1" .

uit:khoan_61c96886_13a1_4ad0_8968_7bbad2329a74 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "61c96886-13a1-4ad0-8968-7bbad2329a74" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Trước khi k ết thúc h ọc kỳ, sinh viên nộp đơn trình bày rõ lý do không th ể hoàn t ất học 
phần cùng các gi ấy tờ minh ch ứng cần thi ết cho cán b ộ giảng d ạy học ph ần đó và 
P.ĐTĐH. Trư ờng hợp đột xuất và có lý do chính đáng, sinh v iên ph ải nộp trong vòng 3 
ngày k ể từ ngày thi kết thúc h ọc phần để được xem xét.""" ;
    uit:hasParent uit:dieu_49fdab7a_823f_4b91_961a_64dafe49403d ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
    uit:level "khoan" ;
    uit:ordinal 22001 ;
    uit:path "1/56/1" ;
    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Khoản 1" .

uit:khoan_61f1bf56_f0bd_4bee_b6ca_9e6aeee2272a a uit:Clause ;
    rdfs:label "Khoản 4" ;
    uit:clauseId "61f1bf56-f0bd-4bee-b6ca-9e6aeee2272a" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Th ời gian t ối đa đư ợc phép h ọc đối với sinh viên h ọc cùng lúc hai chương trình là th ời 
gian t ối đa quy đ ịnh cho chương trình th ứ nhất, quy đ ịnh tại Điều 6 c ủa Quy ch ế này. 
Khi h ọc chương trình th ứ hai, sinh viên đư ợc công nh ận kết quả của những học phần 
có nội dung và kh ối lượng ki ến thức tương đương có trong chương trình th ứ nhất.""" ;
    uit:hasParent uit:dieu_20aeffd4_0606_4966_a9a2_a73192e7a462 ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
    uit:level "khoan" ;
    uit:ordinal 18004 ;
    uit:path "1/52/4" ;
    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Khoản 4" .

uit:khoan_61f464ea_5f2a_4bd8_91a6_ec08c5e72512 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "61f464ea-5f2a-4bd8-91a6-ec08c5e72512" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Văn bằng đại học:
Cách ghi là: QSCZZHTXXXX
Trong đó:
- QSC: Mã trường
- ZZ : 02 số cuối của năm cấp bằng.
- H: Loại chương trình đào tạo. Cụ thể:
+ Văn bằng 1 - Đại trà/Chương trình chuẩn:
Đ
+ Văn bằng 1 - Chất lượng cao:
C
+ Văn bằng 1 - Chương trình tiên tiến:
T
+ Văn bằng 1 - Tài năng:
N
+ Văn bằng 2 - Đại trà/Chương trình chuẩn:
V
+ Văn bằng 2 - Chất lượng cao:
L
+ Liên thông - Đại trà/Chương trình chuẩn:
A
+ Liên thông - Chất lượng cao:
B
- T: Hình thức đào tạo. Cụ thể:
+ Chính quy:
Q
+ Từ xa:
X
-  XXXX: Số thứ tự sinh viên tốt nghiệp theo một loại chương trình, hình thức đào tạo
trong năm ZZ thì phải nối tiếp nhau.""" ;
    uit:hasParent uit:dieu_ec8eaff8_31be_4977_bffd_19ed19cae63f ;
