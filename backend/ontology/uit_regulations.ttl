uit:khoan_345cefa3_4c64_42fa_bf4f_4a11d70e35a3 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "345cefa3-4c64-42fa-bf4f-4a11d70e35a3" ;
