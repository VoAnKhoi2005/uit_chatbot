    uit:title "Khoản 3" .

uit:khoan_662fbf2a_4299_4308_9598_2a02d0a30312 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "662fbf2a-4299-4308-9598-2a02d0a30312" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Điều kiện dự thi kết thúc học phần
Sinh viên được dự thi kết thúc học phần khi có mặt từ 80% trở lên số buổi học theo
thời khóa biểu của học phần đó, trừ những sinh viên được Hiệu trưởng cho phép học
chương trình song ngành.
Giảng viên có thể để nghị P.ĐTĐH không cho sinh viên dự thi kết thúc học phần theo
quy định riêng của môn học đã công bố cho sinh viên.""" ;
    uit:hasParent uit:dieu_727e13c4_f983_4dc3_ad69_a28defc0a5db ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
    uit:level "khoan" ;
    uit:ordinal 20001 ;
    uit:path "3/20/1" ;
    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Khoản 1" .

uit:khoan_6631713e_6d7b_4c1b_a601_43b3e023b377 a uit:Clause ;
    rdfs:label "Khoản 4" ;
    uit:clauseId "6631713e-6d7b-4c1b-a601-43b3e023b377" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Các h ọc phần trong chương trình đào t ạo đư ợc sắp xếp theo trình t ự nhất định vào t ừng 
học kỳ của khóa đào t ạo. Đây là trình t ự mà Trư ờng khuy ến cáo sinh viên nên tuân th ủ 
để thuận lợi nhất cho vi ệc tiếp thu ki ến thức. 
 
Trang 10/27""" ;
    uit:hasParent uit:dieu_2a1685d3_1cc0_487e_ba90_3d9747519614 ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
    uit:level "khoan" ;
    uit:ordinal 7004 ;
    uit:path "1/41/4" ;
    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Khoản 4" .

uit:khoan_666d88a4_4602_40dc_91ee_785b6072dcda a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "666d88a4-4602-40dc-91ee-785b6072dcda" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Mẫu từng loại văn bằng, chứng chỉ theo đúng mẫu văn bằng, chứng chỉ tương ứng
với các trình độ đào tạo do ĐHQG-HCM, Bộ GD&ĐT ban hành.""" ;
    uit:hasParent uit:dieu_ce870022_a232_4a2f_8e05_49a24f59a396 ;
    uit:inDocument uit:Document_b61c9fab_9889_48b7_b2c5_8d7fb72f4110 ;
    uit:level "khoan" ;
