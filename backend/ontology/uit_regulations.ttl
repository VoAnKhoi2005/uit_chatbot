uit:khoan_9a01c86a_e047_4832_8de7_c31501f98ea3 a uit:Clause ;
    rdfs:label "Khoản 4" ;
    uit:clauseId "9a01c86a-e047-4832-8de7-c31501f98ea3" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Sinh viên đ ủ điều kiện tốt nghi ệp được Hiệu trư ởng ra quy ết định công nh ận tốt nghi ệp và 
được cấp bằng tốt nghi ệp trong vòng 03 tháng tính t ừ ngày có quy ết định công nh ận tốt 
nghiệp.""" ;
    uit:hasParent uit:dieu_b8a7e6b5_ed06_4904_84ca_cf6a32876fa1 ;
