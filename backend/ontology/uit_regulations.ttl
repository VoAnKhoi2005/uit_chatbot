uit:khoan_fc6ad03b_9a4a_4fcc_b129_0add7feda693 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "fc6ad03b-9a4a-4fcc-b129-0add7feda693" ;
    uit:docId "e078682d-57d3-420b-924b-5411aee851f3" ;
    uit:docTitle "128-Qd-Dhcntt-Dtdh 30-8-2016 Ban Hanh Qd Day Va Hoc Nn Doi Voi He Dai Hoc Cq Cua Truong Dhcntt Khoa 2016" ;
    uit:fullText """Có 2 phương thức tổ chức lớp học trong chương trình giảng dạy tiếng Anh:
a. Phương thức 1: Lớp tối đa 50 sinh viên.
b. Phương thức 2 (Tiếng Anh tăng cường): Lớp nhỏ tối đa 30 sinh viên, phòng học chất
lượng cao.
Sinh viên được quyền lựa chọn lớp học theo phương thức 1 hoặc phương thức 2.""" ;
    uit:hasParent uit:dieu_ea0199bb_18eb_41b8_aa29_3d647c21d64c ;
    uit:inDocument uit:Document_e078682d_57d3_420b_924b_5411aee851f3 ;
