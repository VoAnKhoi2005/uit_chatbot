    uit:clauseId "4eaa5fd3-5ac1-4034-8767-51d239ad995d" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Đi ểm trung bình chung (ĐTBC) là đi ểm trung bình c ủa các h ọc phần mà sinh viên đã 
đăng ký h ọc từ lúc b ắt đầu khóa h ọc đến thời điểm đư ợc tính v ới trọng số là số tín ch ỉ 
của mỗi học phần (đư ợc tính theo đi ểm học phần cao nh ất trong các l ần học, bao g ồm cả 
những học phần không đ ạt). ĐTBC đư ợc dùng đ ể xét s ố tín ch ỉ được phép đăng ký trong 
học kỳ, học vư ợt, xét chuy ển ngành/chương trình, xét đi ều kiện làm khóa lu ận tốt 
nghiệp.""" ;
    uit:hasParent uit:dieu_dd1bdf30_3f94_4983_bc4e_aadb7cf867f1 ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
