uit:khoan_175ed47d_0bcb_48e9_b336_a6e92e4eabc6 a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "175ed47d-0bcb-48e9-b336-a6e92e4eabc6" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Chấm khóa luận tốt nghiệp : 
Việc chấm kết quả khóa lu ận tốt nghi ệp được thực hiện bởi hội đồng do khoa/b ộ môn 
quản lý ngành đào t ạo đề nghị và Hi ệu trư ởng ký quy ết định thành l ập. Số thành viên 
của hội đồng ch ấm khóa lu ận tốt nghi ệp là 3 ngư ời, bao g ồm: ch ủ tịch, ủy viên thư 
ký và ủy viên. Cán b ộ hướng dẫn không được là thành viên h ội đồng. Chủ tịch và ủy 
viên thư ký h ội đồng không đư ợc kiêm nhi ệm vai trò ph ản biện. Thành viên c ủa hội 
đồng là gi ảng viên c ủa Trư ờng ho ặc có th ể mời những ngư ời có chuyên môn phù h ợp 
ở ngoài Trư ờng. 
Điểm chấm khóa luận cho theo thang điểm 10 (lẻ đến 0,5) của mỗi thành viên hội 
đồng, người hướng dẫn và người phản biện. Điểm tổng kết là trung bình cộng (làm 
tròn đến 0,1) , trong đó : 
o Điểm được cho bởi các thành viên hội đồng không phải là người phản biện có 
hệ số 1. 
o Điểm được cho bởi người hướng dẫn và người phản biện có hệ số 2 . 
Các quy đ ịnh chi ti ết khác v ề khóa lu ận tốt nghi ệp có quy đ ịnh riêng.""" ;
    uit:hasParent uit:dieu_66f72031_6f57_4150_9892_49b816a4597c ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
    uit:level "khoan" ;
    uit:ordinal 32002 ;
    uit:path "1/66/2" ;
    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Khoản 2" .

uit:khoan_1762b788_a2ac_44c9_b306_0ffcd8d593c3 a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "1762b788-a2ac-44c9-b306-0ffcd8d593c3" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Để hoàn t ất chương trình giáo d ục bậc đại học, sinh viên ph ải thực hiện khóa lu ận tốt 
nghiệp ho ặc học các môn chuyên đ ề tốt nghi ệp. Quy đ ịnh v ề các môn chuyên đ ề tốt 
nghiệp được ghi rõ trong chương trình đào t ạo.""" ;
    uit:hasParent uit:dieu_0e3b14ea_6bb6_4136_acfd_783b6dcbc007 ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
    uit:level "khoan" ;
    uit:ordinal 31002 ;
    uit:path "1/65/2" ;
    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Khoản 2" .

uit:khoan_178f43b2_6311_4ce7_8527_e00e8b07de78 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "178f43b2-6311-4ce7-8527-e00e8b07de78" ;
    uit:docId "e078682d-57d3-420b-924b-5411aee851f3" ;
    uit:docTitle "128-Qd-Dhcntt-Dtdh 30-8-2016 Ban Hanh Qd Day Va Hoc Nn Doi Voi He Dai Hoc Cq Cua Truong Dhcntt Khoa 2016" ;
    uit:fullText """Môn học TACM đáp ứng các yêu cầu sau:
a. Là các học phần thuộc khối kiến thức cơ bản, cơ sở hoặc chuyên ngành được giảng dạy
chủ yếu bằng tiếng Anh. Nội dung giảng dạy hoàn toàn giống học phần được giảng dạy bằng
tiếng Việt.
b. Cán bộ giảng dạy (CBGD) lý thuyết phải giảng bằng tiếng Anh.
c. Tài liệu giảng dạy và giáo trình chính của môn học bằng tiếng Anh.""" ;
    uit:hasParent uit:dieu_85a76a2e_f945_4e48_95dd_c0ffcf21aae6 ;
    uit:inDocument uit:Document_e078682d_57d3_420b_924b_5411aee851f3 ;
    uit:level "khoan" ;
    uit:ordinal 8001 ;
    uit:path "3/8/1" ;
    uit:soHieu "128/QD/DHCNTT/DTDH" ;
    uit:title "Khoản 1" .

