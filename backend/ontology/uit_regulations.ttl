uit:dieu_716672fe_7b21_432e_b78c_563235552e95 a uit:Article ;
    rdfs:label "Điều 18" ;
    uit:articleId "716672fe-7b21-432e-b78c-563235552e95" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Người có thẩm quyền quyết định chỉnh sửa nội dung văn bằng, chứng chỉ là Hiệu
trưởng hoặc thủ trưởng đơn vị được ủy quyền cấp chứng chỉ. Trường hợp Trường đã sáp
nhập, chia, tách, giải thể hoặc có sự điều chỉnh về thẩm quyền thì người có thẩm quyền quyết
định chỉnh sửa nội dung văn bằng, chứng chỉ là thủ trưởng cơ quan đang quản lý sổ gốc cấp
văn bằng, chứng chỉ.""" ;
    uit:hasClause uit:khoan_1572d67f_551d_4d18_a55c_c4921e67e07b ;
    uit:hasParent uit:chuong_afd72f04_8421_4434_9604_353050648274 ;
    uit:heading "Thẩm quyền quyết định chỉnh sửa nội dung văn bằng, chứng chỉ" ;
    uit:inDocument uit:Document_b61c9fab_9889_48b7_b2c5_8d7fb72f4110 ;
    uit:level "dieu" ;
    uit:ordinal 4018 ;
    uit:path "4/18" ;
    uit:soHieu "172/QD/DHCNTT" ;
    uit:title "Điều 18" .

uit:dieu_72c9eddb_f993_4c6f_94f6_17885b0e0b8e a uit:Article ;
    rdfs:label "Điều 14" ;
    uit:articleId "72c9eddb-f993-4c6f-94f6-17885b0e0b8e" ;
    uit:docId "c9cbb5b3-7c97-4baf-b5ce-6803d6ef5f3a" ;
    uit:docTitle "507-Qd-Dhcntt-27-5-2024 Quy Che Dao Tao Cho Sinh Vien" ;
    uit:fullText """Sau khi được xét trúng tuyển vào Trường, do một số hoàn cảnh đặc biệt như được điều
động vào các lực lượng vũ trang, thai sản, bệnh tật, tai nạn, hoàn cảnh khó khăn xảy ra đột
xuất, thí sinh trúng tuyển có thể xin bảo lưu kết quả. Thí sinh trúng tuyển phải nộp đơn xin
bảo lưu chậm nhất 15 ngày kể từ ngày gọi nhập học cho P. ĐTĐH thông qua TTPTCNTT
và chỉ được bảo lưu khi có quyết định chấp thuận của Hiệu trưởng.
Thời gian bảo lưu kết quả trúng tuyển không quá 01 năm. Đối với trường hợp được điều
động vào các lực lượng vũ trang thì thời gian bảo lưu kết quả trúng tuyển bằng với thời
gian được điều động. Muốn nhập học lại, thí sinh phải làm đơn xin nhập học và nộp cho
P. ĐTĐH thông qua TTPTCNTT trước khi bắt đầu học kỳ ít nhất 1 tháng để được giải
quyết.""" ;
    uit:hasClause uit:khoan_06fa5c35_acd8_4dd6_82aa_192fc5ab9500 ;
    uit:hasParent uit:chuong_2add494f_1a00_401b_a2ce_facdb1a83e7f ;
    uit:heading "Bảo lưu kết quả trúng tuyển" ;
    uit:inDocument uit:Document_c9cbb5b3_7c97_4baf_b5ce_6803d6ef5f3a ;
    uit:level "dieu" ;
    uit:ordinal 2014 ;
    uit:path "2/14" ;
    uit:soHieu "507/QD/DHCNTT/27/5/2024" ;
    uit:title "Điều 14" .

