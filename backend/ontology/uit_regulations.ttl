uit:dieu_da803db9_cd08_46fb_bde3_d9a6332fcdc3 a uit:Article ;
    rdfs:label "Điều 6" ;
    uit:articleId "da803db9-cd08-46fb-bde3-d9a6332fcdc3" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText """Căn cứ trên thời khóa biểu của học kỳ và thông tin về môn học trong đề cương môn học
(hình thức đánh giá, các thành phần điểm,…), P.ĐTĐH/VPĐB xếp lịch thi và thông báo lịch
thi đến SV và các đơn vị liên quan.
P.ĐTĐH/VPĐB chuẩn bị danh sách SV dự thi và vật tư thi (túi đựng đề thi, giấy thi, giấy
nháp và giấy làm bài thi trắc nghiệm). P.ĐTĐH/VPĐB bàn giao danh sách SV dự thi và vật
tư thi cho Khoa theo số lượng cần thiết. Đơn vị tổ chức thi chia vật tư thi cho từng phòng thi.""" ;
    uit:hasClause uit:khoan_9116c537_7976_4036_9aa2_672cf919ac08 ;
    uit:hasParent uit:chuong_0fcd1d75_5521_4a7f_a3ad_bfdb21a23678 ;
    uit:heading "Xếp lịch thi, chuẩn bị danh sách SV dự thi và vật tư thi" ;
    uit:inDocument uit:Document_0cf30b50_fd07_4dc5_96fe_4b701c1e54ec ;
    uit:level "dieu" ;
    uit:ordinal 2006 ;
    uit:path "2/6" ;
    uit:soHieu "1139" ;
    uit:title "Điều 6" .

