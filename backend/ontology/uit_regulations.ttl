uit:khoan_c0253692_777b_4887_8bb4_c4232f9e2417 a uit:Clause ;
    rdfs:label "Khoản 3" ;
    uit:clauseId "c0253692-777b-4887-8bb4-c4232f9e2417" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Phương th ức đào t ạo của Trư ờng theo h ọc chế tín ch ỉ, giúp cho sinh viên có th ể tích lũy 
kiến thức trong m ọi thời điểm, đ ồng th ời cũng yêu c ầu ở sinh viên tính tích c ực, ch ủ 
động trong vi ệc lập kế hoạch học tập cá nhân nh ằm tạo nên hi ệu quả cao trong h ọc tập và 
rèn luy ện.""" ;
