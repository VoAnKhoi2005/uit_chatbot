uit:diem_05b56a20_e7ae_4f8f_8cbf_07e12f4bf5a5 a uit:Entity ;
    rdfs:label "Điểm a)" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Họ, chữ đệm, tên; ngày tháng năm sinh của người có văn bằng, chứng chỉ được
chỉnh sửa;""" ;
    uit:hasParent uit:khoan_595932ac_f69d_46ef_937b_2b25320874f9 ;
