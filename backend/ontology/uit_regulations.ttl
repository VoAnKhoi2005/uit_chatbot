uit:khoan_e6c0389f_b6f1_4a0a_a3c4_f9ed89085cfc a uit:Clause ;
    rdfs:label "Khoản 3" ;
    uit:clauseId "e6c0389f-b6f1-4a0a-a3c4-f9ed89085cfc" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Cơ quan có thẩm quyền cấp bản sao văn bằng, chứng chỉ từ sổ gốc căn cứ sổ gốc để
cấp bản sao có nội dung đúng như trong sổ gốc. Trường hợp không còn lưu giữ được sổ gốc
hoặc trong sổ gốc không có thông tin về nội dung yêu cầu cấp bản sao hoặc không cấp bản
sao cho người yêu cầu thì cơ quan tiếp nhận có trách nhiệm trả lời bằng văn bản cho người
yêu cầu và nêu rõ lý do theo thời hạn quy định tại điểm b khoản 2 Điều này.""" ;
    uit:hasParent uit:dieu_1ef4e4fd_275c_4995_937d_273d8da4b4c4 ;
    uit:inDocument uit:Document_b61c9fab_9889_48b7_b2c5_8d7fb72f4110 ;
