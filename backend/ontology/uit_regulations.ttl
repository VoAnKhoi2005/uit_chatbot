    uit:title "Khoản 1" .

uit:khoan_43f50d82_e81f_4276_aafd_0dff8a0aee18 a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "43f50d82-e81f-4276-aafd-0dff8a0aee18" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
