uit:khoan_2c61c451_2d02_42be_891a_4cc26fdd94f9 a uit:Clause ;
    rdfs:label "Khoản 9" ;
    uit:clauseId "2c61c451-2d02-42be-891a-4cc26fdd94f9" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Chức danh, chữ ký, họ, chữ đệm, tên của người có thẩm quyền cấp văn bằng, chứng
chỉ và đóng dấu theo quy định.""" ;
    uit:hasParent uit:dieu_1b202472_8ece_4ae8_b106_e47f4055b25b ;
    uit:inDocument uit:Document_b61c9fab_9889_48b7_b2c5_8d7fb72f4110 ;
