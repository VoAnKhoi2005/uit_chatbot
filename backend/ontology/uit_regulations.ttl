uit:khoan_9a0c3415_a884_48ed_aec9_1ceabed4251c a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "9a0c3415-a884-48ed-aec9-1ceabed4251c" ;
    uit:docId "4ad990e5-085f-4143-a5a5-11dc31e82ec5" ;
    uit:docTitle "141-Qd-Dhcntt16-3-2018Quy Dinh Dao Tao Ngoai Ngu Doi Voi He Dh Chinh Quy Cua Truong Dhcntt Ap Dung Tu Khoa 2017 0" ;
    uit:fullText """Môn học TACM được ghi chú rõ về ngôn ngữ giảng dạy trong bảng điểm và giấy chứng
nhận hoàn thành môn học.
7""" ;
    uit:hasParent uit:dieu_2ceaf124_6790_4eff_916a_4a9dc409c815 ;
