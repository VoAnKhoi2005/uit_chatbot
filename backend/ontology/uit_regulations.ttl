uit:khoan_55b93dc2_caea_4391_a553_100b68b1c473 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "55b93dc2-caea-4391-a553-100b68b1c473" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Học cùng lúc hai chương trình đào tạo được áp dụng đối với chương trình song ngành,
dành cho sinh viên có đủ điều kiện theo quy định tại Khoản 2 Điều 18 này và có nhu
cầu đăng ký học thêm một chương trình thứ hai để khi tốt nghiệp được cấp hai văn
bằng.""" ;
    uit:hasParent uit:dieu_747258cf_4eef_4e8d_9074_4ecfa514656d ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
