uit:khoan_aa4bb13a_e3fd_4bee_b5d2_167861541831 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "aa4bb13a-e3fd-4bee-b5d2-167861541831" ;
