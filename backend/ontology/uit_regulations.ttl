    uit:title "Khoản 1" .

uit:khoan_b70aa2c0_0806_4f60_95f5_8f28569ab34c a uit:Clause ;
    rdfs:label "Khoản 3" ;
    uit:clauseId "b70aa2c0-0806-4f60-95f5-8f28569ab34c" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Quy định đào tạo đại học theo hình thức đào tạo từ xa (gọi tắt là hệ đại học từ xa) và đào
tạo các chương trình đặc biệt của Trường được xây dựng, điều chỉnh phù hợp với đặc thù
hệ đào tạo/chương trình dựa trên cơ sở quy chế này.""" ;
    uit:hasParent uit:dieu_bcb1b4ba_fc18_4577_9ee1_dfb5c632bc9f ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
    uit:level "khoan" ;
    uit:ordinal 1003 ;
    uit:path "1/1/3" ;
    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Khoản 3" .

uit:khoan_b785a4ff_2edc_470b_8ab0_09c904340815 a uit:Clause ;
    rdfs:label "Khoản 4" ;
    uit:clauseId "b785a4ff-2edc-470b-8ab0-09c904340815" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Những sinh viên không đủ điều kiện cấp bằng tốt nghiệp nhưng chưa hết thời gian tối đa
được phép học, được bảo lưu các học phần có kết quả đạt. Trong thời gian tối đa được
phép học như quy định tại Khoản 2, Điều 6 của Quy chế này, sinh viên được đăng ký
học lại những học phần chưa đạt hoặc chưa học.""" ;
    uit:hasParent uit:dieu_db641dec_aafe_4e2b_9b7d_3cb69a4b54e9 ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
