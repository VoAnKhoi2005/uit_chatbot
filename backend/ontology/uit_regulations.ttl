    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText "Lấy bài thi của SV làm được giao cho SV khác." ;
    uit:hasParent uit:khoan_9b0c1b7d_bb17_4d24_ac3c_2fdbc6f07250 ;
