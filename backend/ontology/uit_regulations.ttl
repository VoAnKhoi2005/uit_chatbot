    uit:ordinal 3003 ;
    uit:path "1/3/3" ;
    uit:soHieu "172/QD/DHCNTT" ;
    uit:title "Khoản 3" .

uit:khoan_fd0723f9_865f_4cc7_8625_acd8571deed4 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "fd0723f9-865f-4cc7-8625-acd8571deed4" ;
    uit:docId "7b766f6e-e2e0-4435-a6f2-8cd8fa3d69c0" ;
    uit:docTitle "547-Qd-Dhcntt 30-8-2019 Qui Dinh Dao Tao Ngoai Ngu Doi Voi He Chinh Qui Khoa 2019 0 0" ;
    uit:fullText "Biên soạn chương trình, phân công giảng viên giảng dạy các môn học ngoại ngữ." ;
    uit:hasParent uit:dieu_2ac81566_52e4_48f4_be78_1b990647e80f ;
