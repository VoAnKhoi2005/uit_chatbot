uit:khoan_a59c5c42_f2c7_4cd1_a86a_4748869ffad4 a uit:Clause ;
    rdfs:label "Khoản 3" ;
    uit:clauseId "a59c5c42-f2c7-4cd1-a86a-4748869ffad4" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Trong thời gian chờ cấp văn bằng, người học đã tốt nghiệp được Hiệu trưởng Trường
ĐHCNTT cấp giấy chứng nhận tốt nghiệp tạm thời (theo mẫu Phụ lục 7, 8 kèm theo Quy chế
này).""" ;
    uit:hasParent uit:dieu_3e05f363_845b_440a_b607_8902734967c2 ;
    uit:inDocument uit:Document_b61c9fab_9889_48b7_b2c5_8d7fb72f4110 ;
