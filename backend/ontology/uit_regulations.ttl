    uit:title "Khoản 5" .

uit:khoan_5d07582c_e086_4510_885e_16d9d7615236 a uit:Clause ;
    rdfs:label "Khoản 5" ;
    uit:clauseId "5d07582c-e086-4510-885e-16d9d7615236" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText """Mỗi môn học có tối đa 4 bảng điểm thành phần: Bảng điểm cuối kỳ (bắt buộc phải có),
Bảng điểm giữa kỳ, Bảng điểm thực hành (bắt buộc phải có đối với những môn học có tín chỉ
thực hành) và Bảng điểm quá trình (gồm các điểm được cho trong quá trình học như điểm bài
tập, thuyết trình, chuyên cần, …). Tỉ lệ các thành phần điểm và các hình thức đánh giá của
mỗi thành phần điểm được ghi rõ trong Đề cương môn học. Các bảng điểm phải được điền
đầy đủ thông tin.""" ;
    uit:hasParent uit:dieu_0e8f066b_7bce_4b2f_bae1_66effea064ab ;
    uit:inDocument uit:Document_0cf30b50_fd07_4dc5_96fe_4b701c1e54ec ;
    uit:level "khoan" ;
    uit:ordinal 16005 ;
    uit:path "3/16/5" ;
    uit:soHieu "1139" ;
    uit:title "Khoản 5" .

uit:khoan_5d2f17c9_11f9_4061_8e67_234b1100c16a a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "5d2f17c9-11f9-4061-8e67-234b1100c16a" ;
    uit:docId "c9cbb5b3-7c97-4baf-b5ce-6803d6ef5f3a" ;
    uit:docTitle "507-Qd-Dhcntt-27-5-2024 Quy Che Dao Tao Cho Sinh Vien" ;
    uit:fullText """Sinh viên được quyền xin tạm dừng học tập và được bảo lưu kết quả học tập trong các
trường hợp sau:
- Được cơ quan có thẩm quyền điều động, đại diện quốc gia tham dự các kỳ thi, giải
đấu quốc tế.
- Bị ốm, thai sản hoặc tai nạn phải điều trị thời gian dài, có chứng nhận của cơ sở
khám bệnh, chữa bệnh có thẩm quyền theo quy định của Bộ Y tế.
11
- Trường hợp vì lý do cá nhân, sinh viên phải học ít nhất một học kỳ ở Trường và
không rơi vào các trường hợp bị đình chỉ học tập, có xác nhận của gia đình và giấy
tờ liên quan hợp lệ.""" ;
    uit:hasParent uit:dieu_a15ee869_ea1e_4799_8beb_aec2129ab39f ;
    uit:inDocument uit:Document_c9cbb5b3_7c97_4baf_b5ce_6803d6ef5f3a ;
    uit:level "khoan" ;
    uit:ordinal 17002 ;
    uit:path "2/17/2" ;
    uit:soHieu "507/QD/DHCNTT/27/5/2024" ;
    uit:title "Khoản 2" .

uit:khoan_5d3e82f2_b59c_4e2d_8ff9_3173c7fdcbf7 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "5d3e82f2-b59c-4e2d-8ff9-3173c7fdcbf7" ;
