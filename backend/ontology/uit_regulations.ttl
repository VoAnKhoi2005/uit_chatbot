uit:khoan_b15b3707_0d78_4116_8067_7437f1604477 a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "b15b3707-0d78-4116-8067-7437f1604477" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Quy chế này áp dụng đối với tất cả các đơn vị, cá nhân trong và ngoài Trường
ĐHCNTT có liên quan đến công tác quản lý, cấp phát, sử dụng văn bằng, chứng chỉ của
Trường ĐHCNTT.""" ;
    uit:hasParent uit:dieu_daf68806_6727_4f08_b45a_464d449f41f1 ;
    uit:inDocument uit:Document_b61c9fab_9889_48b7_b2c5_8d7fb72f4110 ;
    uit:level "khoan" ;
    uit:ordinal 1002 ;
    uit:path "1/1/2" ;
    uit:soHieu "172/QD/DHCNTT" ;
    uit:title "Khoản 2" .

uit:khoan_b16395f0_1e6e_4111_8023_6c43a050e94c a uit:Clause ;
    rdfs:label "Khoản 3" ;
    uit:clauseId "b16395f0-1e6e-4111-8023-6c43a050e94c" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Đối với đào t ạo theo hình th ức chính quy, t ối đa 30% t ổng kh ối lượng của chương trình 
đào t ạo đư ợc thực hiện bằng phương th ức qua m ạng. Trong trư ờng hợp thiên tai, d ịch 
bệnh phức tạp và các trư ờng hợp bất khả kháng khác, Trường thực hiện theo hư ớng dẫn 
của Bộ Giáo d ục và Đào t ạo và của ĐHQG -HCM .""" ;
    uit:hasParent uit:dieu_b4f9da56_a48e_4ca0_a8e1_bcdd0139b8a6 ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
    uit:level "khoan" ;
    uit:ordinal 28003 ;
    uit:path "1/62/3" ;
    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Khoản 3" .

uit:khoan_b1a54435_a5d0_425e_a6ec_995adb47483d a uit:Clause ;
    rdfs:label "Khoản 4" ;
    uit:clauseId "b1a54435-a5d0-425e-a6ec-995adb47483d" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Những sinh viên không đ ủ điều kiện cấp bằng tốt nghi ệp nhưng chưa h ết thời gian t ối đa 
được phép h ọc, đư ợc bảo lưu các h ọc phần có k ết quả đạt. Trong th ời gian t ối đa đư ợc 
phép h ọc như quy đ ịnh tại Kho ản 2, Đi ều 6 c ủa Quy ch ế này, sinh viên đư ợc đăng ký 
học lại những học phần chưa đ ạt hoặc chưa h ọc.""" ;
    uit:hasParent uit:dieu_75a5c282_6352_4a87_b2f1_6f5224ecb25e ;
