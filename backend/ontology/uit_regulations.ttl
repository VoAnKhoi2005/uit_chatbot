uit:khoan_e2287724_2b6e_41ab_bc3a_be96716133e0 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "e2287724-2b6e-41ab-bc3a-be96716133e0" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText """ĐVQLMH của môn học có trách nhiệm tổ chức công tác chấm thi cho môn học mà
mình quản lý. Khoa chịu trách nhiệm chính về sự chính xác, công bằng và các khía cạnh
chuyên môn khác của việc chấm thi.""" ;
    uit:hasParent uit:dieu_0e8f066b_7bce_4b2f_bae1_66effea064ab ;
    uit:inDocument uit:Document_0cf30b50_fd07_4dc5_96fe_4b701c1e54ec ;
    uit:level "khoan" ;
    uit:ordinal 16001 ;
    uit:path "3/16/1" ;
