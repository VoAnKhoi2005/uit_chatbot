uit:khoan_67a48c3e_efd8_4a43_bd6a_311742aa62dd a uit:Clause ;
    rdfs:label "Khoản 6" ;
    uit:clauseId "67a48c3e-efd8-4a43-bd6a-311742aa62dd" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText """Cán bộ chấm thi thành phần điểm nào chịu trách nhiệm nhập điểm cho thành phần
điểm đó vào Hệ thống quản lý điểm trong thời gian chậm nhất 20 ngày tính từ mốc 01 ngày
sau ngày thi của môn học đó. Cán bộ chấm thi ký tên và nộp cho Khoa bảng điểm được xuất
từ hệ thống.""" ;
    uit:hasParent uit:dieu_0e8f066b_7bce_4b2f_bae1_66effea064ab ;
