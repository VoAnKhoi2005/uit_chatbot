    uit:ordinal 8001 ;
    uit:path "3/8/1" ;
    uit:soHieu "141/QD/DHCNTT16/3/2018QUY" ;
    uit:title "Khoản 1" .

uit:khoan_9acf0d61_7a43_4545_bb4e_35dd3afcce75 a uit:Clause ;
    rdfs:label "Khoản 6" ;
    uit:clauseId "9acf0d61-7a43-4545-bb4e-35dd3afcce75" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Sinh viên trình độ đại học đang học tại các CSĐT khác muốn đăng ký học thêm một
chương trình đào tạo thứ hai tại Trường ĐHCNTT thực hiện theo quy định riêng.""" ;
    uit:hasParent uit:dieu_747258cf_4eef_4e8d_9074_4ecfa514656d ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
