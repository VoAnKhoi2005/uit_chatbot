    uit:title "Khoản 4" .

uit:khoan_55777dc8_1ba2_455b_bd2c_aae40bd5eba8 a uit:Clause ;
    rdfs:label "Khoản 5" ;
    uit:clauseId "55777dc8-1ba2-455b-bd2c-aae40bd5eba8" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Các đơn vị trực thuộc Trường có đào tạo, cấp chứng chỉ chịu trách nhiệm quản lý việc
in thông tin lên phôi và cấp phát chứng chỉ cho người học.""" ;
