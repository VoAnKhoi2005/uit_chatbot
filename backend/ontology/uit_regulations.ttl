uit:diem_597d741e_f1e9_4a7d_8653_e291e6b4971d a uit:Entity ;
    rdfs:label "Điểm b)" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText """Không được mang vào khu vực thi và phòng thi vũ khí, chất gây nổ, gây cháy, bia,
rượu. Không được hút thuốc trong phòng thi;""" ;
    uit:hasParent uit:khoan_7f68e490_95db_4138_a464_b3390bad3b0f ;
