uit:khoan_47eee177_f29a_4dc9_926c_c3e8d2c2c8aa a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "47eee177-f29a-4dc9-926c-c3e8d2c2c8aa" ;
