uit:khoan_003b52dd_1497_41e0_b6bf_e3b6da6371b3 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "003b52dd-1497-41e0-b6bf-e3b6da6371b3" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Trong quá trình h ọc tập, sinh viên có th ể đề nghị Trường cấp bảng đi ểm. Sinh viên th ực 
hiện theo hư ớng dẫn của P.ĐTĐH .""" ;
    uit:hasParent uit:dieu_25673452_4e73_408e_b52d_1f839ae8e991 ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
