uit:dieu_a75caa1b_efb5_411e_931e_0ca733c9487c a uit:Article ;
    rdfs:label "Điều 14" ;
    uit:articleId "a75caa1b-efb5-411e-931e-0ca733c9487c" ;
    uit:docId "e4f0b05e-6ed8-47a8-b1d0-7722507d7b1f" ;
    uit:docTitle "159-Qd-Dhcntt 05-03-2024 Ban Hanh Quy Dinh Kltn" ;
    uit:fullText """Trong trường hợp có tranh chấp, khiếu nại về kết quả chấm bảo vệ KLTN, Hiệu trưởng
có thể chỉ định một Hội đồng để chấm phúc tra. Thành phần, nhiệm vụ, quyền hạn của Hội
đồng phúc tra được Hiệu trưởng quy định trong quyết định thành lập Hội đồng. Điểm cuối
cùng của KLTN là điểm của Hội đồng chấm phúc tra.""" ;
    uit:hasClause uit:khoan_96cd5fd2_c477_4799_acc7_efc9c0ce34c2 ;
    uit:hasParent uit:chuong_38ac3d7d_2b7e_4507_a006_fb46e69e56a0 ;
    uit:heading "Hội đồng chấm phúc tra KLTN" ;
    uit:inDocument uit:Document_e4f0b05e_6ed8_47a8_b1d0_7722507d7b1f ;
    uit:level "dieu" ;
    uit:ordinal 3014 ;
    uit:path "3/14" ;
    uit:soHieu "159/QD/DHCNTT" ;
    uit:title "Điều 14" .

uit:dieu_a7d30cf4_ed80_4868_b14c_2d3756b6a3ad a uit:Article ;
    rdfs:label "Điều 1" ;
    uit:articleId "a7d30cf4-ed80-4868-b14c-2d3756b6a3ad" ;
    uit:docId "e4f0b05e-6ed8-47a8-b1d0-7722507d7b1f" ;
    uit:docTitle "159-Qd-Dhcntt 05-03-2024 Ban Hanh Quy Dinh Kltn" ;
    uit:fullText """Quy định này quy định những yêu cầu, hình thức thực hiện, bảo vệ khoá luận tốt nghiệp,
áp dụng đối với SV bậc đại học hệ chính quy của Trường Đại học Công nghệ Thông tin –
Đại học Quốc gia TP.HCM (sau đây gọi tắt là Trường).""" ;
    uit:hasClause uit:khoan_323c796e_eb24_4f73_8c2a_460f66078b52 ;
    uit:hasParent uit:chuong_8e57e150_b988_4de7_906a_c39a42a8dcf6 ;
    uit:heading "Phạm vi điều chỉnh và đối tượng áp dụng" ;
    uit:inDocument uit:Document_e4f0b05e_6ed8_47a8_b1d0_7722507d7b1f ;
    uit:level "dieu" ;
    uit:ordinal 1001 ;
    uit:path "1/1" ;
    uit:soHieu "159/QD/DHCNTT" ;
    uit:title "Điều 1" .

uit:dieu_a7f1e136_1c85_4993_a1c8_48dba71d48e4 a uit:Article ;
    rdfs:label "Điều 3" ;
    uit:articleId "a7f1e136-1c85-4993-a1c8-48dba71d48e4" ;
    uit:docId "e078682d-57d3-420b-924b-5411aee851f3" ;
    uit:docTitle "128-Qd-Dhcntt-Dtdh 30-8-2016 Ban Hanh Qd Day Va Hoc Nn Doi Voi He Dai Hoc Cq Cua Truong Dhcntt Khoa 2016" ;
    uit:fullText """1 . Chương trình giảng dạy tiếng Anh nhằm mục đích giúp người học:
a . Củng cố toàn diện 4 kỹ năng sử dụng tiếng Anh tổng quát: nghe, nói, đọc, viết; phát triển
kỹ năng sử dụng tiếng Anh chuyên ngành ở trình độ phù hợp với trình độ đào tạo và ngành
đào tạo.
b . Đáp ứng được chuẩn ngoại ngữ tiếng Anh đầu ra theo quy định của ĐHQG-HCM.
2 . Các ngoại ngữ khác được đưa vào chương trình giúp người học có thêm lựa chọn bổ sung
phù hợp với nhu cầu đa dạng của thị trường lao động.
2""" ;
    uit:hasClause uit:khoan_b3569080_088b_4d01_ae08_84ae5c6c8b36 ;
    uit:hasParent uit:chuong_781252ff_2b81_41c6_8fb4_b65e135e20a2 ;
    uit:heading "Mục đích của chương trình giảng dạy tiếng Anh và ngoại ngữ khác" ;
    uit:inDocument uit:Document_e078682d_57d3_420b_924b_5411aee851f3 ;
    uit:level "dieu" ;
    uit:ordinal 1003 ;
    uit:path "1/3" ;
    uit:soHieu "128/QD/DHCNTT/DTDH" ;
    uit:title "Điều 3" .

