uit:khoan_8c7ed615_a17f_4640_8aac_66976ea78ad8 a uit:Clause ;
    rdfs:label "Khoản 7" ;
    uit:clauseId "8c7ed615-a17f-4640-8aac-66976ea78ad8" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText """Khoa lưu 01 bản và nộp cho P.ĐTĐH 01 bản chính của bảng điểm cho mỗi thành phần
điểm. Đối với các thành phần điểm được tổ chức thi tập trung, bảng điểm phải được nộp kèm
theo danh sách có chữ ký của sinh viên tham gia thi và các giấy vào phòng thi (nếu có).""" ;
    uit:hasParent uit:dieu_0e8f066b_7bce_4b2f_bae1_66effea064ab ;
    uit:inDocument uit:Document_0cf30b50_fd07_4dc5_96fe_4b701c1e54ec ;
    uit:level "khoan" ;
    uit:ordinal 16007 ;
    uit:path "3/16/7" ;
    uit:soHieu "1139" ;
    uit:title "Khoản 7" .

uit:khoan_8cc5b353_28d0_4212_9503_4cab79bc2504 a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "8cc5b353-28d0-4212-9503-4cab79bc2504" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Học lại: Sinh viên phải đăng ký học lại các học phần bắt buộc có điểm học phần dưới 5,0
ở các học kỳ trước. Đối với các học phần tự chọn, nếu điểm dưới 5,0 sinh viên được
phép đăng ký học lại học phần đó hoặc chọn học phần khác thay thế trong số các học
phần tự chọn quy định cho mỗi ngành đào tạo.
Khi nộp hồ sơ xét tốt nghiệp, sinh viên có thể làm đơn xin hủy học phần tự chọn đã học
(sinh viên không được hủy kết quả học tập trong lúc đang học).""" ;
    uit:hasParent uit:dieu_730e0f62_1eb0_43f7_9905_c1a411f6f68c ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
    uit:level "khoan" ;
    uit:ordinal 14002 ;
    uit:path "2/14/2" ;
    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Khoản 2" .

