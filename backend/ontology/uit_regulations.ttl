    uit:soHieu "125/QD/DHCNTT/DTDH" ;
    uit:title "Khoản 2" .

uit:khoan_b64aaf44_1357_4c44_b4aa_541753a1e8b9 a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "b64aaf44-1357-4c44-b4aa-541753a1e8b9" ;
    uit:docId "4ad990e5-085f-4143-a5a5-11dc31e82ec5" ;
    uit:docTitle "141-Qd-Dhcntt16-3-2018Quy Dinh Dao Tao Ngoai Ngu Doi Voi He Dh Chinh Quy Cua Truong Dhcntt Ap Dung Tu Khoa 2017 0" ;
    uit:fullText """Tốt nghiệp một trường đại học nước ngoài, có sử dụng tiếng Anh trong quá trình học tập
(có môn học bằng tiếng Anh, hoặc luận án tốt nghiệp được viết bằng tiếng Anh).""" ;
    uit:hasParent uit:dieu_b5f1f7fb_def6_4094_9385_5ad4913670e3 ;
