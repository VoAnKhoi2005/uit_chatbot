uit:diem_0b918676_bf23_4194_b114_30daa61867f9 a uit:Entity ;
    rdfs:label "Điểm d)" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText """Kiểm tra việc ghi và tô mã đề thi vào phiếu TLTN của SV (so sánh mã đề thi đã ghi, tô
trên phiếu TLTN và ghi trên phiếu thu bài thi với mã đề thi ghi trên tờ đề thi của SV).""" ;
    uit:hasParent uit:khoan_59302370_deee_4501_b978_a05ed41485a6 ;
    uit:inDocument uit:Document_0cf30b50_fd07_4dc5_96fe_4b701c1e54ec ;
