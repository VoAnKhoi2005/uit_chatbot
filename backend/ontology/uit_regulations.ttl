uit:khoan_a4be891b_4f08_426b_8f74_e81364d5791c a uit:Clause ;
    rdfs:label "Khoản 3" ;
    uit:clauseId "a4be891b-4f08-426b-8f74-e81364d5791c" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Đối với chương trình đào tạo chuyên sâu đặc thù, yêu cầu khối lượng thực tập tối thiểu là
8 tín chỉ.""" ;
    uit:hasParent uit:dieu_4fd02477_fa14_4919_a871_9dbca47ea298 ;
