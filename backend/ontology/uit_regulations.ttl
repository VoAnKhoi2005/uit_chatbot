    uit:title "Điểm d)" .

uit:diem_0c5259fd_b5ea_41db_a07c_d62355e7ed49 a uit:Entity ;
    rdfs:label "Điểm a)" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Kiểm tra, đối chiếu và ghi chính xác, đầy đủ các thông tin ghi trên văn bằng, chứng
chỉ. Cung cấp các thông tin dự kiến ghi trên văn bằng, chứng chỉ cho người học để người học
kiểm tra tính chính xác của các thông tin trước khi ghi trên văn bằng, chứng chỉ; yêu cầu
người học xác nhận về việc đã kiểm tra thông tin, ký xác nhận các yêu cầu chỉnh sửa thông
tin và cung cấp các căn cứ yêu cầu chỉnh sửa thông tin. Các thông tin liên quan đến khai sinh
của người học ghi trên văn bằng, chứng chỉ phải căn cứ vào giấy khai sinh hợp lệ và hồ sơ
trúng tuyển của người học;""" ;
    uit:hasParent uit:khoan_22248e39_e895_4144_97a4_793991c4c063 ;
    uit:inDocument uit:Document_b61c9fab_9889_48b7_b2c5_8d7fb72f4110 ;
    uit:level "diem" ;
    uit:ordinal 3.00701e+03 ;
    uit:path "1/3/7/a" ;
    uit:soHieu "172/QD/DHCNTT" ;
    uit:title "Điểm a)" .

uit:diem_0c6ceccb_98d6_49a7_8524_6273c5e6c044 a uit:Entity ;
    rdfs:label "Điểm d)" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Xây dựng kế hoạch và thực hiện các điều kiện đảm bảo chất lượng giáo dục đối với
chương trình đào tạo đang triển khai.
đ) Định kỳ sau một khóa đào tạo, thực hiện rà soát chỉnh sửa, bổ sung chương trình
đào tạo phù hợp với quy định về chuẩn chương trình đào tạo và phù hợp với nhu cầu của thị
trường lao động.""" ;
    uit:hasParent uit:khoan_811cd632_9166_4fa5_b178_fd0482565cc3 ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
    uit:level "diem" ;
    uit:ordinal 7.00104e+03 ;
    uit:path "1/7/1/d" ;
    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Điểm d)" .

