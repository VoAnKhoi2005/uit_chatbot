    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Lý do chỉnh sửa;
đ) Hiệu lực và trách nhiệm thi hành quyết định.""" ;
    uit:hasParent uit:khoan_595932ac_f69d_46ef_937b_2b25320874f9 ;
