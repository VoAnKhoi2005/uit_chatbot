    uit:title "Khoản 2" .

uit:khoan_10ebf0ee_b4d7_48fd_8583_70e0b2af5f0a a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "10ebf0ee-b4d7-48fd-8583-70e0b2af5f0a" ;
