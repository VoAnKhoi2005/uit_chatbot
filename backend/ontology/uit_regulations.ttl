    uit:title "Điểm c)" .

uit:diem_0a8465b1_d2ed_4a59_89ad_d9886cbc3871 a uit:Entity ;
    rdfs:label "Điểm c)" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Trường hợp người yêu cầu cấp bản sao văn bằng, chứng chỉ từ sổ gốc là người được
quy định tại khoản 2 Điều 26 của Quy chế này thì phải xuất trình giấy ủy quyền (đối với
người được ủy quyền) hoặc giấy tờ chứng minh quan hệ với người được cấp bản chính văn
bằng, chứng chỉ.""" ;
    uit:hasParent uit:khoan_30a25b1d_dd21_43f5_9d02_0724cf6450c4 ;
    uit:inDocument uit:Document_b61c9fab_9889_48b7_b2c5_8d7fb72f4110 ;
    uit:level "diem" ;
    uit:ordinal 2.700103e+04 ;
    uit:path "5/27/1/c" ;
    uit:soHieu "172/QD/DHCNTT" ;
    uit:title "Điểm c)" .

uit:diem_0ac432ad_5ba7_485f_876b_53be3b05e6b6 a uit:Entity ;
    rdfs:label "Điểm b)" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Căn cứ chương trình môn học và kết quả trên bảng điểm học tập của sinh viên, Hiệu
trưởng quyết định việc công nhận kết quả học tập, khối lượng kiến thức và các môn
học cần phải bổ sung.""" ;
    uit:hasParent uit:khoan_8d0b5f2a_d2f0_4a8e_b7fd_b2817eddeddd ;
