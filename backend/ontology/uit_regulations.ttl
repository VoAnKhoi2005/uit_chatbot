uit:diem_0806070a_cec0_4551_b320_e664eb89eb03 a uit:Entity ;
    rdfs:label "Điểm c)" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Ngôn ngữ đào tạo: Chương trình tiên tiến ghi Tiếng Anh (English); các chương trình còn lại ghi Tiếng Việt (Vietnamese)
18
Phụ lục 3
Mẫu PHỤ LỤC VĂN BẰNG ĐẠI HỌC HỆ TỪ XA (mặt sau)
(Ban hành kèm theo Quyết định số: 172/QĐ-ĐHCNTT,  ngày 08 tháng 3 năm 2023
của Hiệu trưởng Trường Đại học Công nghệ Thông tin)
Ghi chú:""" ;
    uit:hasParent uit:khoan_03adafec_74fe_4ba7_9403_47d293922e71 ;
    uit:inDocument uit:Document_b61c9fab_9889_48b7_b2c5_8d7fb72f4110 ;
