    uit:title "Khoản 4" .

uit:khoan_2e68265f_3544_449f_96b7_fdb9d79a2109 a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "2e68265f-3544-449f-96b7-fdb9d79a2109" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText """Khi dự thi, SV mang theo một trong những giấy tờ chứng minh cá nhân hợp lệ sau
đây: thẻ SV được cấp bởi Trường ĐH CNTT, chứng minh nhân dân, căn cước công dân hoặc
bằng lái xe.""" ;
    uit:hasParent uit:dieu_54b86a0d_17c5_4751_8afc_28419a140001 ;
    uit:inDocument uit:Document_0cf30b50_fd07_4dc5_96fe_4b701c1e54ec ;
    uit:level "khoan" ;
    uit:ordinal 4002 ;
    uit:path "1/4/2" ;
    uit:soHieu "1139" ;
    uit:title "Khoản 2" .

uit:khoan_2ecaeed2_7758_4e07_bbfa_043956c8f660 a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "2ecaeed2-7758-4e07-bbfa-043956c8f660" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Người thực hiện nhiệm vụ cấp bản sao văn bằng, chứng chỉ từ sổ gốc do thiếu tinh
thần trách nhiệm hoặc cố ý làm trái các quy định của Quy chế này và các văn bản quy phạm
pháp luật khác thì tuỳ theo mức độ vi phạm có thể bị xử lý kỷ luật hoặc truy cứu trách nhiệm
hình sự; nếu gây thiệt hại thì phải bồi thường theo quy định của pháp luật.""" ;
    uit:hasParent uit:dieu_56d919c5_1a19_490f_b124_fe7c0e77d96b ;
    uit:inDocument uit:Document_b61c9fab_9889_48b7_b2c5_8d7fb72f4110 ;
    uit:level "khoan" ;
    uit:ordinal 31002 ;
    uit:path "6/31/2" ;
    uit:soHieu "172/QD/DHCNTT" ;
    uit:title "Khoản 2" .

uit:khoan_2f4d854e_2a19_40c0_94bd_1279371601a1 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "2f4d854e-2a19-40c0-94bd-1279371601a1" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText """SV phải có mặt tại phòng thi trước 15 phút theo thời gian ghi trong lịch thi do P.ĐTĐH
công bố. SV đến chậm quá 15 phút sau khi đã bóc đề thi thì không được dự thi.""" ;
    uit:hasParent uit:dieu_b2315ddd_8c4f_4c6f_a329_a85407032552 ;
