uit:khoan_de2c3e1f_3db4_44a4_bec0_0c0aa155a9c3 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "de2c3e1f-3db4-44a4-bec0-0c0aa155a9c3" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Sổ cấp bản sao văn bằng, chứng chỉ từ sổ gốc là tài liệu do cơ quan có thẩm quyền
quy định tại Điều 25 Quy chế này lập ra khi thực hiện việc cấp bản sao văn bằng, chứng chỉ
từ sổ gốc trong đó ghi chép đầy đủ những nội dung như bản sao mà đơn vị đã cấp.
Sổ cấp bản sao văn bằng, chứng chỉ từ sổ gốc phải được ghi chép chính xác, đánh số
trang, đóng dấu giáp lai, không được tẩy xóa, đảm bảo quản lý chặt chẽ và lưu trữ vĩnh viễn.""" ;
    uit:hasParent uit:dieu_d5fbb089_36b7_4d57_89bb_8e84925b597b ;
    uit:inDocument uit:Document_b61c9fab_9889_48b7_b2c5_8d7fb72f4110 ;
