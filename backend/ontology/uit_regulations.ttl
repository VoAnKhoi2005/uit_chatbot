uit:khoan_0dd62e72_56ae_4950_868b_32cb962b2939 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "0dd62e72-56ae-4950-868b-32cb962b2939" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Điểm trung bình học kỳ (ĐTBHK) là điểm trung bình của các học phần mà sinh viên đã
đăng ký học trong học kỳ đó với trọng số là số tín chỉ của mỗi học phần (bao gồm cả
những học phần không đạt). ĐTBHK được dùng để xét học bổng, khen thưởng, xử lý
học vụ sau mỗi học kỳ.""" ;
    uit:hasParent uit:dieu_8b688d0b_c2b6_4aba_b775_593997cdd308 ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
