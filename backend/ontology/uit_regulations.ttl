uit:diem_e6cc1b16_d364_479b_a6b3_fdfc094b8876 a uit:Entity ;
    rdfs:label "Điểm c)" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText """Khi nhận đề thi phải để đề thi dưới tờ phiếu TLTN; không được xem đề thi khi CBCT
chưa cho phép;""" ;
    uit:hasParent uit:khoan_9eed8eee_ced0_442d_b78a_49c296037970 ;
