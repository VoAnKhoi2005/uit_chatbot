    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText """Đưa đề thi ra ngoài khu vực thi hoặc đưa bài giải từ ngoài vào phòng thi trong lúc đang
thi.""" ;
    uit:hasParent uit:khoan_7dccd7a4_91f5_4788_8d35_2155dc8715ae ;
