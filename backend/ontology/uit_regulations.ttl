uit:khoan_a3fadec8_4030_4f58_a763_658e952747d1 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "a3fadec8-4030-4f58-a763-658e952747d1" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText """Nếu phát hiện sai sót trong đề thi, các CBCT phải báo cáo ngay cho đơn vị tổ chức
môn thi đó để có phương án xử lý thích hợp. Tùy theo tính chất và mức độ sai sót nặng hay
nhẹ, tùy theo sai sót xảy ra ở một câu hay nhiều câu của đề thi, tùy theo thời gian phát hiện
sớm hay muộn, lãnh đạo trực thi cân nhắc và ra quyết định xử lý. Trong trường hợp sai sót
nặng, phải báo cáo và xin ý kiến Hiệu trưởng.""" ;
    uit:hasParent uit:dieu_92802be6_b552_4160_932a_35cbbc2083a9 ;
    uit:inDocument uit:Document_0cf30b50_fd07_4dc5_96fe_4b701c1e54ec ;
    uit:level "khoan" ;
    uit:ordinal 10001 ;
    uit:path "2/10/1" ;
    uit:soHieu "1139" ;
    uit:title "Khoản 1" .

uit:khoan_a47921a2_0fe8_4a67_a0e0_6afde51d1138 a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "a47921a2-0fe8-4a67-a0e0-6afde51d1138" ;
    uit:docId "e078682d-57d3-420b-924b-5411aee851f3" ;
    uit:docTitle "128-Qd-Dhcntt-Dtdh 30-8-2016 Ban Hanh Qd Day Va Hoc Nn Doi Voi He Dai Hoc Cq Cua Truong Dhcntt Khoa 2016" ;
    uit:fullText "Môn học TACM tuân thủ theo các quy định trong Chương III của quy định này." ;
    uit:hasParent uit:dieu_d830b2a1_a00d_42f1_943f_def14d37bd82 ;
