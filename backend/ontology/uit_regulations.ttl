uit:khoan_242e6b36_239b_44ad_af55_423ac9d10006 a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "242e6b36-239b-44ad-af55-423ac9d10006" ;
    uit:docId "65b3de70-0d5b-43ee-a4d9-93a1ef996b58" ;
    uit:docTitle "125-Qd-Dhcntt-Dtdh 18-09-2015 Quyet Dinh Ban Hanh Qui Dinh Tam Thoi Day Va Hoc Tieng Anh Khoa 2015 0" ;
    uit:fullText """Sau học kỳ chính thứ 4 của khóa học, nếu sinh viên không đạt môn học Anh văn 1 trong
chương trình tiếng Anh quy định tại Khoản 3, Điều 4 và nếu không có các chứng chỉ tiếng
Anh tương đương với trình độ TOEIC ≥350 điểm thì sinh viên đó buộc phải học các lớp
tiếng Anh tăng cường để đạt, đồng thời chỉ được đăng ký tối đa 02 môn học không phải là
các môn tiếng Anh (bao gồm cả đăng ký học lại hoặc cải thiện).""" ;
    uit:hasParent uit:dieu_eaf4a9db_a8fb_49d9_924f_6443f3f02f7e ;
    uit:inDocument uit:Document_65b3de70_0d5b_43ee_a4d9_93a1ef996b58 ;
    uit:level "khoan" ;
    uit:ordinal 3002 ;
    uit:path "0/3/2" ;
    uit:soHieu "125/QD/DHCNTT/DTDH" ;
    uit:title "Khoản 2" .

uit:khoan_24316c2c_448a_46e4_9a19_c8e36f4a7323 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "24316c2c-448a-46e4-9a19-c8e36f4a7323" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Chương trình song ngành gồm hai phần: chương trình đào tạo ngành thứ nhất có khối
lượng kiến thức tối thiểu theo quy định tại Điều 7, ngành thứ hai có khối lượng kiến thức
từ 30 tín chỉ trở lên (những nội dung giống nhau, tương đương giữa hai chương trình đào
tạo chỉ được tính khối lượng kiến thức một lần). Việc tổ chức và quản lý đào tạo được
thực hiện liên thông giữa các khoa, bộ môn trong Trường hoặc giữa các CSĐT trong
ĐHQG-HCM.""" ;
    uit:hasParent uit:dieu_ea2aca8e_058e_4d67_9789_07597c2d1870 ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
    uit:level "khoan" ;
    uit:ordinal 9001 ;
    uit:path "1/9/1" ;
    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Khoản 1" .

