uit:khoan_f0491377_3dbe_428a_990c_e2c0e2b2404c a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "f0491377-3dbe-428a-990c-e2c0e2b2404c" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Tổ ch ức các đợt thi tập trung 
Mỗi học kỳ chính Trư ờng tổ chức một kỳ kiểm tra gi ữa kỳ và m ột kỳ thi kết thúc h ọc 
kỳ. Hai đ ợt thi đư ợc tổ chức tập trung theo k ế hoạch gi ảng d ạy và h ọc tập của Trường. 
Khoa, b ộ môn, gi ảng viên không t ổ chức thi ngoài các đ ợt đã thông báo. Hi ệu trư ởng quy 
định th ời gian h ọc, ôn thi và thi cho t ừng học kỳ.""" ;
    uit:hasParent uit:dieu_5665b605_45b8_4998_8229_62cec9e19c68 ;
