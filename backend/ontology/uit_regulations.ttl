    uit:clauseId "df0178ac-3000-4dcb-bc5c-06d10ab29327" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Không tính kết quả thi các học phần Giáo dục quốc phòng-An ninh và Giáo dục thể chất
vào ĐTBHK, ĐTBC hoặc ĐTBCTL. Việc đánh giá kết quả và điều kiện cấp chứng chỉ
đối với học phần này theo quy định riêng của Bộ GD&ĐT.""" ;
    uit:hasParent uit:dieu_8b688d0b_c2b6_4aba_b775_593997cdd308 ;
