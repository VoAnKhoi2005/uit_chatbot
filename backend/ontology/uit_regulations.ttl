    uit:title "Khoản 9" .

uit:khoan_2e02f4ed_e657_488b_9663_5a10147497b7 a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "2e02f4ed-e657-488b-9663-5a10147497b7" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Chứng chỉ ứng dụng công nghệ thông tin, kết quả Điểm trắc nghiệm, Điểm thực hành, tại Hội đồng thi
(nếu không thành lập Hội đồng thi thì không ghi)""" ;
    uit:hasParent uit:dieu_ec8eaff8_31be_4977_bffd_19ed19cae63f ;
    uit:inDocument uit:Document_b61c9fab_9889_48b7_b2c5_8d7fb72f4110 ;
