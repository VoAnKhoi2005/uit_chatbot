uit:diem_6bd23781_11b5_4b30_84c3_5eba663162f6 a uit:Entity ;
    rdfs:label "Điểm b)" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText """Điền chính xác và đủ thông tin vào các mục trống ở phía trên phiếu TLTN, điền chính
xác mã đề thi vào hai phiếu thu bài thi;""" ;
    uit:hasParent uit:khoan_9eed8eee_ced0_442d_b78a_49c296037970 ;
