    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText """Chuẩn bị thi, tổ chức thi, tổ chức chấm thi và chấm phúc khảo cho những môn học do
đơn vị đó quản lý;""" ;
    uit:hasParent uit:dieu_518b7eb7_6222_4f3a_a15f_d56469e59bc6 ;
