uit:khoan_3e035733_a0d4_4600_acb8_ff26a7bff25d a uit:Clause ;
    rdfs:label "Khoản 4" ;
    uit:clauseId "3e035733-a0d4-4600-acb8-ff26a7bff25d" ;
    uit:docId "e4f0b05e-6ed8-47a8-b1d0-7722507d7b1f" ;
    uit:docTitle "159-Qd-Dhcntt 05-03-2024 Ban Hanh Quy Dinh Kltn" ;
    uit:fullText """Nếu hết thời gian thực hiện KLTN theo quy định mà SV không đủ điều kiện ra bảo vệ
vào đúng đợt bảo vệ chính thức, SV có thể làm đơn xin gia hạn thời gian làm KLTN thêm
01 học kỳ (phải được sự đồng ý của CBHD và Khoa). SV làm Đơn gia hạn thời gian làm
5
KLTN (theo mẫu) nộp về P.ĐTĐH/VPĐB. Khi có quyết định gia hạn thời gian làm KLTN,
trường hợp SV đã hết thời gian thiết kế chương trình đào tạo phải đóng học phí gia hạn
theo quy định và có khống chế điểm tối đa.""" ;
    uit:hasParent uit:dieu_a98349b7_57a6_40fa_b917_8321963fd22e ;
