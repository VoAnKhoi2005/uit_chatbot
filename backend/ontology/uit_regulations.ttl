uit:khoan_fde8fb7b_9e37_42c9_a4e7_569efdcee1a3 a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "fde8fb7b-9e37-42c9-a4e7-569efdcee1a3" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Trường hợp có căn cứ bản sao giả mạo, không hợp pháp, cơ quan, tổ chức tiếp nhận
bản sao văn bằng, chứng chỉ yêu cầu người có bản sao văn bằng, chứng chỉ xuất trình bản
chính để đối chiếu hoặc tiến hành xác minh.""" ;
    uit:hasParent uit:dieu_f182bf1a_fa7f_4563_8b8f_869d4a89f526 ;
    uit:inDocument uit:Document_b61c9fab_9889_48b7_b2c5_8d7fb72f4110 ;
    uit:level "khoan" ;
    uit:ordinal 24002 ;
    uit:path "5/24/2" ;
    uit:soHieu "172/QD/DHCNTT" ;
    uit:title "Khoản 2" .

uit:khoan_fe10d8f7_e1af_4e82_a761_09b13fe8e858 a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "fe10d8f7-e1af-4e82-a761-09b13fe8e858" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Chuyển trường
Sinh viên được chuyển trường nếu có đủ các điều kiện sau:
- Không đang là sinh viên trình độ năm thứ nhất hoặc năm cuối khóa, không thuộc
diện bị xử lý học vụ từ cảnh báo trở lên (trường hợp bị kỷ luật vì kết quả học tập có
thể được Hiệu trưởng xem xét, quyết định cho chuyển) và còn đủ thời gian học tập
theo quy định tại Điều 6 của Quy chế này;
- Sinh viên đạt điều kiện trúng tuyển của chương trình, ngành đào tạo cùng khóa tuyển
sinh tại nơi chuyển đến;
- Nơi chuyển đến có đủ các điều kiện bảo đảm chất lượng, chưa vượt quá năng lực đào
tạo đối với chương trình, ngành đào tạo đó theo quy định hiện hành của Bộ Giáo dục
và Đào tạo;
- Được sự đồng ý của Hiệu trưởng trường xin chuyển đi và Hiệu trưởng trường tiếp
nhận.
Sinh viên xin chuyển trường phải có hồ sơ xin chuyển trường theo mẫu quy định.
Thời gian tối đa được phép học đối với sinh viên chuyển ngành/chương trình đào
tạo/trường là thời gian tối đa hoàn thành khóa học được quy định tại Điều 6 của Quy chế
này.
Trang 18/27""" ;
    uit:hasParent uit:dieu_96cca472_631f_4abf_b113_d35f58fd8ac8 ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
    uit:level "khoan" ;
    uit:ordinal 19002 ;
    uit:path "2/19/2" ;
    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Khoản 2" .

uit:khoan_febda6b9_2c4c_4fc9_a8a9_3a56e16bf64e a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "febda6b9-2c4c-4fc9-a8a9-3a56e16bf64e" ;
    uit:docId "c9cbb5b3-7c97-4baf-b5ce-6803d6ef5f3a" ;
    uit:docTitle "507-Qd-Dhcntt-27-5-2024 Quy Che Dao Tao Cho Sinh Vien" ;
    uit:fullText """Môn học trong chương trình đào tạo được tổ chức giảng dạy theo một hoặc kết hợp
nhiều phương thức:
+ Học tập trung: Mỗi môn học có thể được tổ chức giảng dạy tập trung tại địa điểm
đào tạo của Trường.
9
+ Học trực tuyến: Giảng viên giảng dạy, hướng dẫn sinh viên học tập trao đổi, thảo
luận thông qua các hệ thống phần mềm giảng dạy trực tuyến.""" ;
    uit:hasParent uit:dieu_9f58f82b_8179_4ae4_a678_2df1d6e98167 ;
    uit:inDocument uit:Document_c9cbb5b3_7c97_4baf_b5ce_6803d6ef5f3a ;
    uit:level "khoan" ;
    uit:ordinal 12001 ;
    uit:path "2/12/1" ;
    uit:soHieu "507/QD/DHCNTT/27/5/2024" ;
    uit:title "Khoản 1" .

uit:khoan_ff59b28d_3689_4ddc_a0ce_919bcf770f81 a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "ff59b28d-3689-4ddc-a0ce-919bcf770f81" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Sinh viên có trách nhiệm thực hiện đầy đủ các yêu cầu của môn học như lên lớp, làm bài
tập, thực hành, thí nghiệm, tham gia thảo luận, dự kiểm tra thường kỳ và thi kết thúc học
phần.""" ;
    uit:hasParent uit:dieu_a482ac29_dc22_4449_a4dd_7504f677a716 ;
