    uit:ordinal 26001 ;
    uit:path "4/26/1" ;
    uit:soHieu "507/QD/DHCNTT/27/5/2024" ;
    uit:title "Khoản 1" .

uit:khoan_d989bc2d_a906_4cec_adf9_de4a40c07bd4 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "d989bc2d-a906-4cec-adf9-de4a40c07bd4" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Hiệu trưởng Trường ĐHCNTT có trách nhiệm cấp văn bằng cho người học trong
thời hạn:
a) 30 ngày kể từ ngày có quyết định công nhận tốt nghiệp đại học.
b) 30 ngày kể từ ngày có quyết định công nhận tốt nghiệp và cấp bằng thạc sĩ.
c) 30 ngày kể từ ngày có quyết định công nhận học vị tiến sĩ và cấp bằng tiến sĩ.""" ;
    uit:hasParent uit:dieu_3e05f363_845b_440a_b607_8902734967c2 ;
    uit:inDocument uit:Document_b61c9fab_9889_48b7_b2c5_8d7fb72f4110 ;
    uit:level "khoan" ;
    uit:ordinal 14001 ;
    uit:path "4/14/1" ;
    uit:soHieu "172/QD/DHCNTT" ;
    uit:title "Khoản 1" .

uit:Document_00eb91de_18da_49a8_8e85_41c82c3d04b3 a uit:Document ;
