uit:dieu_a0847f7f_a101_4fb5_81f1_695c86d6618c a uit:Article ;
    rdfs:label "Điều 9" ;
    uit:articleId "a0847f7f-a101-4fb5-81f1-695c86d6618c" ;
    uit:docId "65b3de70-0d5b-43ee-a4d9-93a1ef996b58" ;
    uit:docTitle "125-Qd-Dhcntt-Dtdh 18-09-2015 Quyet Dinh Ban Hanh Qui Dinh Tam Thoi Day Va Hoc Tieng Anh Khoa 2015 0" ;
    uit:fullText """CBGD phải đáp ứng yêu cầu theo quy định chung của Trường; ngoài ra, CBGD lý thuyết
phải đáp ứng thêm một trong các yêu cầu sau đây:
a. Có trình độ tiếng Anh tối thiểu tương đương cấp độ C1 tham chiếu theo khung
Châu Âu(CEFR).
5
b. Tốt nghiệp một trường đại học nước ngoài, có sử dụng tiếng Anh trong quá trình
học tập (có môn học bằng tiếng Anh, hoặc luận án tốt nghiệp được viết bằng tiếng
Anh).
c. Tốt nghiệp một trường đại học trong nước theo chương trình đào tạo sử dụng
100% tiếng Anh.""" ;
    uit:hasClause uit:khoan_d620fd72_7b7e_4989_9b84_94dbaf12c1ac ;
    uit:hasParent uit:chuong_00bd9e43_7621_4751_9a78_aa08fcc3f8f5 ;
    uit:heading "Yêu cầu về cán bộ giảng dạy" ;
    uit:inDocument uit:Document_65b3de70_0d5b_43ee_a4d9_93a1ef996b58 ;
