uit:khoan_3f3bd30d_14e5_4956_a361_1f87a5ab9cfd a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "3f3bd30d-14e5-4956-a361-1f87a5ab9cfd" ;
