uit:khoan_6dd378e1_a43d_4abc_a03b_64ab3c6ab943 a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "6dd378e1-a43d-4abc-a03b-64ab3c6ab943" ;
    uit:docId "4ad990e5-085f-4143-a5a5-11dc31e82ec5" ;
    uit:docTitle "141-Qd-Dhcntt16-3-2018Quy Dinh Dao Tao Ngoai Ngu Doi Voi He Dh Chinh Quy Cua Truong Dhcntt Ap Dung Tu Khoa 2017 0" ;
    uit:fullText """Trường chỉ xét miễn học trong vòng ba học kỳ đầu của Khóa học. Hai tuần trước khi bắt
đầu học kỳ, sinh viên đạt các chứng chỉ được quy định tại Khoản 1 Điều này nộp bản sao
chứng chỉ còn hiệu lực cho Trường để được xét miễn các môn tiếng Anh tương ứng. Sau
thời gian này, sinh viên không được xét miễn học các môn tiếng Anh.""" ;
    uit:hasParent uit:dieu_98a54035_061f_4737_92a9_8f079669b7b5 ;
