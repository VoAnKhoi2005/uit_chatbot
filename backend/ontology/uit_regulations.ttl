    uit:fullText """Đối với chương trình đào t ạo chuyên sâu đ ặc thù, yêu c ầu khối lượng th ực tập tối thiểu là 
8 tín ch ỉ.""" ;
    uit:hasParent uit:dieu_edc98c59_17ec_400f_9238_115f52678f6d ;
