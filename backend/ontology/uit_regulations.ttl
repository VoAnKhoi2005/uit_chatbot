uit:khoan_cd1f40d7_7949_401a_8ee0_77cf3a7a4543 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "cd1f40d7-7949-401a-8ee0-77cf3a7a4543" ;
