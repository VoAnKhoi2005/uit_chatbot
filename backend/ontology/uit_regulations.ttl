uit:khoan_eeb785d9_6cc2_407c_bec9_a2a99a7d8bfc a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "eeb785d9-6cc2-407c-bec9-a2a99a7d8bfc" ;
    uit:docId "4ad990e5-085f-4143-a5a5-11dc31e82ec5" ;
    uit:docTitle "141-Qd-Dhcntt16-3-2018Quy Dinh Dao Tao Ngoai Ngu Doi Voi He Dh Chinh Quy Cua Truong Dhcntt Ap Dung Tu Khoa 2017 0" ;
    uit:fullText """của Hiệu trưởng Trường ĐHCNTT ban hành quy định chuẩn ngoại ngữ xét tốt nghiệp đối
với sinh viên hệ đại học chính quy của Trường Đại học Công nghệ Thông tin. Các quyết
định trước đây trái với quyết định này đều được bãi bỏ.""" ;
    uit:hasParent uit:dieu_b2c7c942_20ae_4d36_b04c_eabc6db098f9 ;
