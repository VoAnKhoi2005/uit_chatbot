    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText """Phải bảo vệ bài làm của mình, không được xem bài của SV khác, không được trao đổi
ý kiến, trao đổi tài liệu khi làm bài; Không được sử dụng các vật dụng giúp gian lận trong
khi thi như: tài liệu bị cấm sử dụng, phương tiện thông tin liên lạc,…;""" ;
    uit:hasParent uit:khoan_7f68e490_95db_4138_a464_b3390bad3b0f ;
    uit:inDocument uit:Document_0cf30b50_fd07_4dc5_96fe_4b701c1e54ec ;
    uit:level "diem" ;
    uit:ordinal 1.300205e+04 ;
    uit:path "2/13/2/e" ;
    uit:soHieu "1139" ;
    uit:title "Điểm e)" .

uit:diem_9310f1c4_4f6b_4389_a152_f60d8c52ae31 a uit:Entity ;
    rdfs:label "Điểm a)" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Được cấp sau khi người học hoàn thành chương trình đào tạo hoặc bồi dưỡng nâng
cao trình độ học vấn, nghề nghiệp theo chương trình do Bộ GD&ĐT quy định hoặc ban hành.""" ;
    uit:hasParent uit:khoan_b7acd037_c829_4426_9abf_ffb36685a3ad ;
    uit:inDocument uit:Document_b61c9fab_9889_48b7_b2c5_8d7fb72f4110 ;
    uit:level "diem" ;
    uit:ordinal 1.300201e+04 ;
    uit:path "4/13/2/a" ;
    uit:soHieu "172/QD/DHCNTT" ;
    uit:title "Điểm a)" .

uit:diem_95c6e35e_7fb9_45b8_afdc_cc01ebb48697 a uit:Entity ;
    rdfs:label "Điểm a)" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Sinh viên được công nhận và chuyển đổi tín chỉ đối với những môn học đã tích lũy có
từ 80% trở lên nội dung tương đương với nội dung môn học trong chương trình đào
tạo;""" ;
    uit:hasParent uit:khoan_8d0b5f2a_d2f0_4a8e_b7fd_b2817eddeddd ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
    uit:level "diem" ;
    uit:ordinal 2.600201e+04 ;
    uit:path "3/26/2/a" ;
    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Điểm a)" .

uit:diem_96b35534_323c_4751_a58b_6dfb929bb2ca a uit:Entity ;
    rdfs:label "Điểm a)" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Nhóm h ọc phần bắt buộc gồm nh ững học phần chứa đựng nh ững nội dung ki ến thức 
chính y ếu của ngành đào t ạo, bắt buộc sinh viên ph ải đăng ký h ọc và tích lũy.""" ;
    uit:hasParent uit:khoan_f0611363_c692_4481_bd7a_e788dfa62321 ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
    uit:level "diem" ;
    uit:ordinal 7.00301e+03 ;
    uit:path "1/41/3/a" ;
    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Điểm a)" .

uit:diem_995f3bb2_6e46_4e48_be2d_c537beaaec1d a uit:Entity ;
    rdfs:label "Điểm d)" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Giấy khai sinh đối với trường hợp chỉnh sửa văn bằng, chứng chỉ do bổ sung hộ
tịch, điều chỉnh hộ tịch, đăng ký lại việc sinh, đăng ký khai sinh quá hạn;
đ) Giấy chứng minh thư nhân dân hoặc căn cước công dân hoặc hộ chiếu hoặc giấy tờ
tùy thân hợp pháp khác có ảnh của người được cấp văn bằng, chứng chỉ. Thông tin ghi trên
các giấy tờ này phải phù hợp với đề nghị chỉnh sửa nội dung văn bằng, chứng chỉ. Các tài
liệu trong hồ sơ đề nghị chỉnh sửa văn bằng, chứng chỉ quy định tại các điểm b, c, d, đ khoản
1 Điều này có thể là bản sao từ sổ gốc hoặc bản sao được chứng thực từ bản chính.
Nếu tài liệu trong hồ sơ đề nghị chỉnh sửa văn bằng, chứng chỉ quy định tại các điểm
b, c, d, đ khoản 1 Điều này là bản sao không có chứng thực thì người đề nghị chỉnh sửa văn
bằng, chứng chỉ phải xuất trình bản chính để người tiếp nhận hồ sơ đối chiếu; người tiếp nhận
hồ sơ phải ký xác nhận và ghi rõ họ tên vào bản sao và chịu trách nhiệm về tính chính xác
của bản sao so với bản chính.""" ;
    uit:hasParent uit:khoan_f5c8033d_4ef1_4605_9045_dacd5ed4e89a ;
    uit:inDocument uit:Document_b61c9fab_9889_48b7_b2c5_8d7fb72f4110 ;
    uit:level "diem" ;
    uit:ordinal 2.000104e+04 ;
    uit:path "4/20/1/d" ;
    uit:soHieu "172/QD/DHCNTT" ;
    uit:title "Điểm d)" .

uit:diem_9b1c5e4b_a7fb_4dd4_8613_c558502f9727 a uit:Entity ;
    rdfs:label "Điểm b)" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Thể hiện rõ trình độ đào tạo; điều kiện tuyển sinh và điều kiện tốt nghiệp; mục tiêu
đào tạo; chuẩn kiến thức, kỹ năng, mức tự chủ và trách nhiệm của người học khi tốt nghiệp;
khối lượng kiến thức lý thuyết, thực hành, thực tập; kế hoạch đào tạo theo thời gian thiết kế;
phương pháp và hình thức đào tạo; cách thức đánh giá kết quả học tập; các điều kiện thực
hiện chương trình đào tạo của CSĐT.
Trang 9/27""" ;
    uit:hasParent uit:khoan_811cd632_9166_4fa5_b178_fd0482565cc3 ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
    uit:level "diem" ;
    uit:ordinal 7.00102e+03 ;
    uit:path "1/7/1/b" ;
    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Điểm b)" .

uit:diem_9b7a35b0_834d_4b65_ab9e_c8ebb8d542e7 a uit:Entity ;
    rdfs:label "Điểm b)" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Khối kiến thức giáo d ục chuyên nghi ệp gồm các h ọc phần cơ sở ngành và các h ọc 
phần chuyên ngành nh ằm cung c ấp cho ngư ời học những ki ến thức và k ỹ năng ngh ề 
nghiệp cần thiết. Kh ối kiến thức giáo d ục chuyên nghi ệp được quy đ ịnh cụ thể trong 
từng chương trình đào t ạo. Những môn h ọc cơ s ở ngành c hung c ủa nhiều ngành khác 
nhau gọi là môn h ọc cơ s ở nhóm ngành.""" ;
    uit:hasParent uit:khoan_604b4940_33cb_4de0_b844_23843fdeca70 ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
    uit:level "diem" ;
    uit:ordinal 7.00202e+03 ;
    uit:path "1/41/2/b" ;
    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Điểm b)" .

