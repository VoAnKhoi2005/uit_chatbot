uit:khoan_c09aa4ea_7b50_4052_8b66_ec9d4f5ee36e a uit:Clause ;
    rdfs:label "Khoản 4" ;
    uit:clauseId "c09aa4ea-7b50-4052-8b66-ec9d4f5ee36e" ;
    uit:docId "c9cbb5b3-7c97-4baf-b5ce-6803d6ef5f3a" ;
    uit:docTitle "507-Qd-Dhcntt-27-5-2024 Quy Che Dao Tao Cho Sinh Vien" ;
    uit:fullText """Những sinh viên không đủ điều kiện cấp bằng tốt nghiệp nhưng chưa hết thời gian tối
đa được phép học, được bảo lưu các học phần có kết quả đạt. Trong thời gian tối đa
được phép học như quy định tại Khoản 2, Điều 10 của Quy chế này, sinh viên được đăng
ký học lại những học phần chưa đạt hoặc chưa học.""" ;
    uit:hasParent uit:dieu_0fbfd418_6497_4b24_a75f_8c790ab44a5e ;
    uit:inDocument uit:Document_c9cbb5b3_7c97_4baf_b5ce_6803d6ef5f3a ;
