    uit:path "5/27/3" ;
    uit:soHieu "172/QD/DHCNTT" ;
    uit:title "Khoản 3" .

uit:khoan_e6cf6b33_20b7_44dd_91ca_b91bf9748434 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "e6cf6b33-20b7-44dd-91ca-b91bf9748434" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText "Được cơ quan có thẩm quyền xác nhận thay đổi hoặc cải chính hộ tịch." ;
    uit:hasParent uit:dieu_99709532_6ef1_4add_b1a7_dd1b0e385cd5 ;
