uit:khoan_c8e27837_21bf_45f4_8dc8_f7888fd5598d a uit:Clause ;
    rdfs:label "Khoản 4" ;
    uit:clauseId "c8e27837-21bf-45f4-8dc8-f7888fd5598d" ;
    uit:docId "e078682d-57d3-420b-924b-5411aee851f3" ;
    uit:docTitle "128-Qd-Dhcntt-Dtdh 30-8-2016 Ban Hanh Qd Day Va Hoc Nn Doi Voi He Dai Hoc Cq Cua Truong Dhcntt Khoa 2016" ;
    uit:fullText """Phòng ĐTĐH phối hợp với Bộ môn Anh văn kiểm tra và báo cáo Hiệu trưởng ra quyết định
công nhận việc miễn học cho sinh viên.""" ;
    uit:hasParent uit:dieu_1ac50498_67fb_48a8_a02d_4ab5238f5154 ;
    uit:inDocument uit:Document_e078682d_57d3_420b_924b_5411aee851f3 ;
