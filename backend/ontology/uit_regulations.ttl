    uit:path "4/21/2" ;
    uit:soHieu "172/QD/DHCNTT" ;
    uit:title "Khoản 2" .

uit:khoan_10d55dd8_0558_454c_9adf_873c97169513 a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "10d55dd8-0558-454c-9adf-873c97169513" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Căn c ứ biên b ản và đ ề nghị của Hội đồng xét t ốt nghi ệp, Hi ệu trư ởng ký quy ết định 
công nh ận tốt nghi ệp cho nh ững sinh viên đ ủ điều kiện theo quy đ ịnh. 
Trang 26/27""" ;
    uit:hasParent uit:dieu_b8a7e6b5_ed06_4904_84ca_cf6a32876fa1 ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
