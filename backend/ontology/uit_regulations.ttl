uit:khoan_af9a1305_51b2_488c_90f1_1d859c89def6 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "af9a1305-51b2-488c-90f1-1d859c89def6" ;
    uit:docId "c9cbb5b3-7c97-4baf-b5ce-6803d6ef5f3a" ;
    uit:docTitle "507-Qd-Dhcntt-27-5-2024 Quy Che Dao Tao Cho Sinh Vien" ;
    uit:fullText """Hệ thống ĐTTX gồm: Chương trình ĐTTX đã được xây dựng, thẩm định và ban hành
theo quy định hiện hành; học liệu ĐTTX; bộ máy tổ chức và quản lý, giám sát ĐTTX; hệ
thống kiểm tra, đánh giá; hệ thống kỹ thuật hỗ trợ thực hiện ĐTTX; đội ngũ giảng viên,
cán bộ hỗ trợ học tập, cán bộ quản lý; các văn bản quy định về ĐTTX.""" ;
    uit:hasParent uit:dieu_2b8d3f0c_31ee_43fc_81c6_a31f223a1108 ;
    uit:inDocument uit:Document_c9cbb5b3_7c97_4baf_b5ce_6803d6ef5f3a ;
    uit:level "khoan" ;
    uit:ordinal 5001 ;
    uit:path "1/5/1" ;
    uit:soHieu "507/QD/DHCNTT/27/5/2024" ;
    uit:title "Khoản 1" .

uit:khoan_afea4d2c_9e2e_42f2_9b9c_a19d46593105 a uit:Clause ;
    rdfs:label "Khoản 8" ;
    uit:clauseId "afea4d2c-9e2e-42f2-9b9c-a19d46593105" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
