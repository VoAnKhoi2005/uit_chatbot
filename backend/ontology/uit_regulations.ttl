uit:khoan_7f802a34_9cf2_4792_9df8_cbbf591fb193 a uit:Clause ;
    rdfs:label "Khoản 5" ;
    uit:clauseId "7f802a34-9cf2-4792-9df8-cbbf591fb193" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText """Khi đóng gói đề thi phải bảo đảm đề thi đúng môn thi ghi ở phong bì đề thi, đủ số
lượng đề thi cho từng phòng thi và dư 3 đề thi để dự phòng, không có tờ trắng, tờ hỏng. Cán
bộ nhân đề thi đóng gói, ký tên niêm phong túi đề thi ngay sau khi nhân đề.""" ;
    uit:hasParent uit:dieu_962d674d_2400_457c_8910_ffa497bf1c3d ;
    uit:inDocument uit:Document_0cf30b50_fd07_4dc5_96fe_4b701c1e54ec ;
