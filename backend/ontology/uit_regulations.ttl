uit:khoan_e0aa6f07_54d4_48a9_af81_79eacd09aec1 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "e0aa6f07-54d4-48a9-af81-79eacd09aec1" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Đầu khoá h ọc, Trư ờng có trách nhi ệm thông báo cho sinh viên v ề: 
- Chương trình đào tạo toàn khóa cho từng ngành học. 
- Quy chế học tập và các quy định của Trường. 
- Quyền lợi và nghĩa vụ của sinh viên.""" ;
    uit:hasParent uit:dieu_276e9c14_9b7c_450f_b480_d9ec79aebd6f ;
