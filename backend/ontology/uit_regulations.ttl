uit:khoan_33a96142_1aa1_4c43_842f_48efecb1cf04 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "33a96142-1aa1-4c43-842f-48efecb1cf04" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Sổ gốc cấp văn bằng, chứng chỉ là tài liệu do Trường ĐHCNTT lập ra khi thực hiện
việc cấp bản chính văn bằng, chứng chỉ trong đó có ghi chép đầy đủ những nội dung tiếng
Việt như bản chính đã cấp.""" ;
    uit:hasParent uit:dieu_f3a93d3e_826c_401a_b57e_a6ba9897eb8a ;
