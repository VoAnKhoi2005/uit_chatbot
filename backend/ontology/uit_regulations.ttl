    uit:ordinal 14003 ;
    uit:path "4/14/3" ;
    uit:soHieu "172/QD/DHCNTT" ;
    uit:title "Khoản 3" .

uit:khoan_a5c63f2a_3c23_489b_8dfa_d776d04572c0 a uit:Clause ;
