    uit:title "Khoản 2" .

uit:khoan_2bafb25e_eec7_42f6_9923_c022fff7320d a uit:Clause ;
    rdfs:label "Khoản 3" ;
    uit:clauseId "2bafb25e-eec7-42f6-9923-c022fff7320d" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Thông tin về cấp văn bằng, chứng chỉ được công bố công khai phải đảm bảo chính
xác và đầy đủ các nội dung như sổ gốc văn bằng, chứng chỉ quy định tại Quy chế này; phải
được cập nhật và lưu trữ thường xuyên trên trang thông tin điện tử của Trường; đảm bảo dễ
quản lý, truy cập, tìm kiếm.""" ;
    uit:hasParent uit:dieu_6ffdf72d_754f_4e64_8d78_0ec41b4258ca ;
    uit:inDocument uit:Document_b61c9fab_9889_48b7_b2c5_8d7fb72f4110 ;
