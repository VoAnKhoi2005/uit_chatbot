uit:dieu_e6f6a00f_b1ea_48d8_9a08_6b4db8fa68db a uit:Article ;
    rdfs:label "Điều 11" ;
    uit:articleId "e6f6a00f-b1ea-48d8-9a08-6b4db8fa68db" ;
    uit:docId "c9cbb5b3-7c97-4baf-b5ce-6803d6ef5f3a" ;
    uit:docTitle "507-Qd-Dhcntt-27-5-2024 Quy Che Dao Tao Cho Sinh Vien" ;
    uit:fullText """Học phí được thu theo từng học kỳ và được tính theo công thức sau:
Học phí = HPTCHM × TCHPHM + HPTCHL × TCHPHL + HPTCCT × TCHPCT
Trong đó:
- HPTCHM: mức học phí cho loại tín chỉ học phí học mới.
- TCHPHM: tổng số tín chỉ học phí của các môn học mới.
- HPTCHL: mức học phí cho loại tín chỉ học phí học lại.
- TCHPHL: tổng số tín chỉ học phí của các môn học lại.
- HPTCCT: mức học phí cho loại tín chỉ học phí học cải thiện.
- TCHPCT: tổng số tín chỉ học phí của các môn học cải thiện.
Vào đầu khóa học hoặc năm học, Trường công bố mức học phí cho mỗi loại tín chỉ học
phí.""" ;
    uit:hasClause uit:khoan_f2141ff7_71c5_463f_a9f5_a5856d419a84 ;
    uit:hasParent uit:chuong_2add494f_1a00_401b_a2ce_facdb1a83e7f ;
    uit:heading "Nguyên tắc xác định học phí" ;
    uit:inDocument uit:Document_c9cbb5b3_7c97_4baf_b5ce_6803d6ef5f3a ;
    uit:level "dieu" ;
    uit:ordinal 2011 ;
    uit:path "2/11" ;
    uit:soHieu "507/QD/DHCNTT/27/5/2024" ;
    uit:title "Điều 11" .

uit:dieu_e72f77a4_a784_4d2b_9477_a9dcf49fd5aa a uit:Article ;
    rdfs:label "Điều 34" ;
    uit:articleId "e72f77a4-a784-4d2b-9477-a9dcf49fd5aa" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """CHƯƠNG 6. ĐIỀU KHOẢN THI HÀNH ................................ ................................ .......................... 27 
 
 
Trang 3/27 
 DANH M ỤC TỪ VIẾT TẮT 
 
ĐHCNTT Đại học Công nghệ Thông tin 
ĐHQG -HCM Đại học Quốc gia TP. Hồ Chí Minh 
P. ĐTĐH Phòng Đào tạo Đại học 
Bộ GD&ĐT Bộ Giáo dục và Đào tạo 
TCHP Tín chỉ học phí 
TCHPHL Tín chỉ học phí học lại 
TCHPCT Tín chỉ học phí học cải thiện 
TCHPHM Tín chỉ học phí học mới 
HPHK Học phí học kỳ 
CSĐT Cơ sở đào tạo 
ĐTBHK Điểm trung bình học kỳ 
ĐTB C Điểm trung bình chung 
ĐTBCTL Điểm trung bình chung tích lũy 
ĐKHP Đăng ký học phần 
Văn bằng 1 Đào tạo cấp bằng tốt nghiệp đại học cho người đã có bằng tốt 
nghiệp trung học phổ thông hoặc bằng tốt nghiệp trung cấp 
Văn bằng 2 Đào tạo cấp bằng tốt nghiệp đại học thứ hai cho người đã có bằng 
tốt nghiệp đại học 
Liên t hông Đào tạo cấp bằng tốt nghiệp đại học cho người đã tốt nghiệp trình 
độ cao đẳng 
 
 
Trang 4/27 
 CHƯƠNG 1. QUY ĐỊNH CHUNG 
""" ;
    uit:hasClause uit:khoan_6cb09be1_d03d_45a6_acb9_b4d7bac58fdc ;
    uit:hasParent uit:chuong_d285d5aa_a986_4d7b_abb3_fd301bfb9f60 ;
    uit:heading "Cấp bằng tốt nghiệp ................................ ................................ ................................ .......... 26" ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
    uit:level "dieu" ;
    uit:ordinal 35 ;
    uit:path "1/34" ;
    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Điều 34" .

