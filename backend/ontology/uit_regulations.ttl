uit:khoan_7789b17c_0acf_4734_b72a_8fd7374a9177 a uit:Clause ;
    rdfs:label "Khoản 7" ;
    uit:clauseId "7789b17c-0acf-4734-b72a-8fd7374a9177" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText """Nếu có SV vi phạm quy định thi thì CBCT phải lập biên bản xử lý (Mẫu THI-M06).
Nếu có tình huống bất thường phải báo cáo ngay cho Trưởng đơn vị tổ chức thi giải quyết;""" ;
    uit:hasParent uit:dieu_894561d9_bc4e_4fd3_8cdd_412a0efc193b ;
    uit:inDocument uit:Document_0cf30b50_fd07_4dc5_96fe_4b701c1e54ec ;
