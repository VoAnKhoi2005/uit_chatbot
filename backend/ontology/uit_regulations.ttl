    uit:path "2/7/1" ;
    uit:soHieu "128/QD/DHCNTT/DTDH" ;
    uit:title "Khoản 1" .

uit:khoan_fce47387_688e_48c1_830b_9f55b0e2552a a uit:Clause ;
    rdfs:label "Khoản 3" ;
    uit:clauseId "fce47387-688e-48c1-830b-9f55b0e2552a" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Phòng Đào tạo Sau đại học & Khoa học Công nghệ (PĐTSĐH-KHCN) có trách nhiệm
quản lý việc cấp văn bằng thạc sĩ, tiến sĩ; thực hiện các thủ tục đề nghị cấp phôi bằng từ
ĐHQG-HCM, quản lý phôi, thông tin in lên phôi và tổ chức thực hiện công tác lưu trữ, cấp
phát, thu hồi, hủy bỏ bằng thạc sĩ, tiến sĩ; bản sao bằng thạc sĩ, tiến sĩ của Trường ĐHCNTT.""" ;
    uit:hasParent uit:dieu_c5c001f1_9e7e_4bef_b7e7_b70f2bf91aa2 ;
    uit:inDocument uit:Document_b61c9fab_9889_48b7_b2c5_8d7fb72f4110 ;
