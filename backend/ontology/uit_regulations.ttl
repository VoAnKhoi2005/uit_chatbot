    uit:title "Khoản 6" .

uit:khoan_6265694b_5812_46b1_9782_5331b92d45a3 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "6265694b-5812-46b1-9782-5331b92d45a3" ;
    uit:docId "c9cbb5b3-7c97-4baf-b5ce-6803d6ef5f3a" ;
    uit:docTitle "507-Qd-Dhcntt-27-5-2024 Quy Che Dao Tao Cho Sinh Vien" ;
    uit:fullText """Quy chế này quy định về đào tạo từ xa (ĐTTX) trình độ đại học, bao gồm: những quy
định chung; lập kế hoạch và tổ chức giảng dạy; đánh giá kết quả học tập và cấp bằng
của Trường Đại học Công nghệ Thông tin (gọi tắt là Trường) thuộc Đại học Quốc gia
TP. HCM (ĐHQG-HCM).""" ;
    uit:hasParent uit:dieu_0bef0b7a_9bc0_4725_bc72_90950db218b5 ;
    uit:inDocument uit:Document_c9cbb5b3_7c97_4baf_b5ce_6803d6ef5f3a ;
    uit:level "khoan" ;
    uit:ordinal 1001 ;
    uit:path "1/1/1" ;
    uit:soHieu "507/QD/DHCNTT/27/5/2024" ;
    uit:title "Khoản 1" .

uit:khoan_626705fa_9e81_49e2_9d31_b6739c846733 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "626705fa-9e81-49e2-9d31-b6739c846733" ;
    uit:docId "e4f0b05e-6ed8-47a8-b1d0-7722507d7b1f" ;
    uit:docTitle "159-Qd-Dhcntt 05-03-2024 Ban Hanh Quy Dinh Kltn" ;
    uit:fullText """Mỗi đề tài KLTN do tối thiểu 1 CBHD có học vị từ thạc sĩ trở lên hướng dẫn. Nếu KLTN
gồm 2 CBHD thì phải phân rõ trách nhiệm hướng dẫn chính và hướng dẫn phụ. Trường
hợp mời CBHD bên ngoài hướng dẫn thì phải có một CBHD là cán bộ của Trường.""" ;
    uit:hasParent uit:dieu_d95e06ab_5c3d_4609_a4a5_5f34a234a2d3 ;
    uit:inDocument uit:Document_e4f0b05e_6ed8_47a8_b1d0_7722507d7b1f ;
    uit:level "khoan" ;
    uit:ordinal 6001 ;
    uit:path "2/6/1" ;
    uit:soHieu "159/QD/DHCNTT" ;
    uit:title "Khoản 1" .

uit:khoan_62caff15_73f4_4777_b3bb_10260848ee3f a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "62caff15-73f4-4777-b3bb-10260848ee3f" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Quy chế này quy định về việc quản lý văn bằng giáo dục đại học, sau đại học và các
loại chứng chỉ (sau đây gọi tắt là văn bằng, chứng chỉ) của Trường Đại học Công nghệ Thông
tin (ĐHCNTT); gồm: quản lý văn bằng, chứng chỉ; nội dung, ngôn ngữ, phương thức ghi
trong văn bằng, chứng chỉ; cấp phát, chỉnh sửa, thu hồi, hủy bỏ văn bằng, chứng chỉ; cấp bản
sao văn bằng từ sổ gốc; kiểm tra, thanh tra, xử lý vi phạm.""" ;
    uit:hasParent uit:dieu_daf68806_6727_4f08_b45a_464d449f41f1 ;
    uit:inDocument uit:Document_b61c9fab_9889_48b7_b2c5_8d7fb72f4110 ;
    uit:level "khoan" ;
    uit:ordinal 1001 ;
    uit:path "1/1/1" ;
    uit:soHieu "172/QD/DHCNTT" ;
    uit:title "Khoản 1" .

uit:khoan_62cd93e5_4b43_42c3_a743_567b9680d08f a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "62cd93e5-4b43-42c3-a743-567b9680d08f" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText """Đối với kỳ thi cuối học kỳ, các môn học có nhiều hơn 01 cán bộ giảng dạy phải có cán
bộ chấm thi cho một lớp học khác với cán bộ giảng dạy của lớp học đó (chấm chéo).""" ;
    uit:hasParent uit:dieu_0e8f066b_7bce_4b2f_bae1_66effea064ab ;
    uit:inDocument uit:Document_0cf30b50_fd07_4dc5_96fe_4b701c1e54ec ;
    uit:level "khoan" ;
    uit:ordinal 16002 ;
    uit:path "3/16/2" ;
    uit:soHieu "1139" ;
    uit:title "Khoản 2" .

uit:khoan_62dbc8b5_154b_4160_af2d_94da1a66d6a1 a uit:Clause ;
    rdfs:label "Khoản 3" ;
    uit:clauseId "62dbc8b5-154b-4160-af2d-94da1a66d6a1" ;
    uit:docId "c9cbb5b3-7c97-4baf-b5ce-6803d6ef5f3a" ;
    uit:docTitle "507-Qd-Dhcntt-27-5-2024 Quy Che Dao Tao Cho Sinh Vien" ;
    uit:fullText """Hội đồng xét tốt nghiệp do Hiệu trưởng hoặc Phó Hiệu trưởng được Hiệu trưởng ủy
quyền làm Chủ tịch, Trưởng phòng hoặc Phó Trưởng phòng Đào tạo Đại học làm thư
ký; các thành viên khác là lãnh đạo Phòng, Ban, Khoa có liên quan và TTPTCNTT.""" ;
    uit:hasParent uit:dieu_b21bfc2b_58ac_4f78_98de_d0f0a50b115c ;
    uit:inDocument uit:Document_c9cbb5b3_7c97_4baf_b5ce_6803d6ef5f3a ;
    uit:level "khoan" ;
    uit:ordinal 21003 ;
    uit:path "3/21/3" ;
    uit:soHieu "507/QD/DHCNTT/27/5/2024" ;
    uit:title "Khoản 3" .

uit:khoan_636846b8_4420_493e_8ea4_5db5c327707e a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "636846b8-4420-493e-8ea4-5db5c327707e" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText """P.ĐTĐH, Văn phòng các Chương trình đặc biệt (VPĐB) và các khoa, bộ môn, trung tâm
(gọi tắt là Đơn vị quản lý môn học - ĐVQLMH) có trách nhiệm chuẩn bị và tổ chức thi cho
những môn học do mình quản lý. Đơn vị có trách nhiệm chuẩn bị và tổ chức thi cho môn học
được gọi tắt là Đơn vị tổ chức thi.""" ;
    uit:hasParent uit:dieu_8cfd8b78_539f_4938_b1fc_1c94e2bb5f73 ;
    uit:inDocument uit:Document_0cf30b50_fd07_4dc5_96fe_4b701c1e54ec ;
    uit:level "khoan" ;
    uit:ordinal 5001 ;
    uit:path "2/5/1" ;
    uit:soHieu "1139" ;
    uit:title "Khoản 1" .

uit:khoan_650059b9_fca4_45e7_a5b1_1b80d7d76fd4 a uit:Clause ;
    rdfs:label "Khoản 3" ;
    uit:clauseId "650059b9-fca4-45e7-a5b1-1b80d7d76fd4" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Chương trình tiên tiến: được thiết kế, xây dựng dựa trên cơ sở chương trình đang 
được áp dụng ở trường đại học tiên tiến trên thế giới (gọi tắt là chương trình gốc ) 
được giảng dạy bằng ngôn ngữ của chương trình gốc.""" ;
    uit:hasParent uit:dieu_ba94d805_b056_4d69_b0a6_4eb59f124751 ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
    uit:level "khoan" ;
    uit:ordinal 8003 ;
    uit:path "1/42/3" ;
    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Khoản 3" .

uit:khoan_65021dc0_8ebc_475c_965a_b4f98ac4bf31 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "65021dc0-8ebc-475c-965a-b4f98ac4bf31" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText """SV có tên trong danh sách thi hoặc có giấy vào phòng thi được cấp bởi Phòng Đào tạo
Đại học (P.ĐTĐH). SV có đăng ký môn học hợp lệ trong học kỳ và đóng học phí đầy đủ trước
thời hạn quy định được dự thi.
3""" ;
    uit:hasParent uit:dieu_54b86a0d_17c5_4751_8afc_28419a140001 ;
    uit:inDocument uit:Document_0cf30b50_fd07_4dc5_96fe_4b701c1e54ec ;
    uit:level "khoan" ;
    uit:ordinal 4001 ;
    uit:path "1/4/1" ;
    uit:soHieu "1139" ;
    uit:title "Khoản 1" .

uit:khoan_6511bf87_514b_4af6_ab40_8378f5f3e9cd a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "6511bf87-514b-4af6-ab40-8378f5f3e9cd" ;
    uit:docId "e078682d-57d3-420b-924b-5411aee851f3" ;
    uit:docTitle "128-Qd-Dhcntt-Dtdh 30-8-2016 Ban Hanh Qd Day Va Hoc Nn Doi Voi He Dai Hoc Cq Cua Truong Dhcntt Khoa 2016" ;
    uit:fullText """Đối với ngoại ngữ là tiếng Pháp hoặc Tiếng Nhật, sinh viên phải nộp các chứng chỉ còn hiệu
lực để được xét tốt nghiệp theo Bảng 5 dưới đây.
6
Cấp độ (CEFR)
Tiếng Pháp
Tiếng  Nhật
B1
DELF B1
TCF niveau 3
JLPT  N3
Bảng 5. Chuẩn đầu ra tiếng Pháp và tiếng Nhật""" ;
    uit:hasParent uit:dieu_86c420bd_bc75_4708_b175_6a84f705555b ;
    uit:inDocument uit:Document_e078682d_57d3_420b_924b_5411aee851f3 ;
    uit:level "khoan" ;
    uit:ordinal 12002 ;
    uit:path "4/12/2" ;
    uit:soHieu "128/QD/DHCNTT/DTDH" ;
    uit:title "Khoản 2" .

uit:khoan_655a5620_bd99_4db8_8e13_1d879db2831b a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "655a5620-bd99-4db8-8e13-1d879db2831b" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Sinh viên dự thính
- Sinh viên của các cơ sở đào tạo khác thuộc ĐHQG-HCM và những cá nhân có đủ
điều kiện về nhân thân và trình độ, có nhu cầu học bổ túc kiến thức, có thể được
Trường xem xét cho trở thành sinh viên dự thính. Hiệu trưởng ra quyết định công
nhận sinh viên dự thính.
- Sinh viên dự thính thực hiện đầy đủ nghĩa vụ theo quy định của Trường được cấp
giấy chứng nhận kết quả học tập cho những học phần đã học.
- Sinh viên dự thính đóng học phí theo mức riêng, không được hưởng chính sách dành
cho sinh viên chính quy và không được cấp bằng tốt nghiệp đại học.""" ;
    uit:hasParent uit:dieu_28c0b3c3_66e6_467e_8df9_3caec6b6d8bc ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
    uit:level "khoan" ;
    uit:ordinal 10002 ;
    uit:path "2/10/2" ;
    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Khoản 2" .

uit:khoan_65870910_0da4_47fe_9de4_13dc68d73d83 a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "65870910-0da4-47fe-9de4-13dc68d73d83" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Phương thức ghi nội dung
- (1) Ghi họ tên của người được cấp chứng chỉ theo giấy khai sinh; in chữ font Times
New Roman, hoa (All caps), đậm (Bold),  kích cỡ (Size) 13, màu đen.
- (2) Ghi ngày, tháng, năm sinh theo giấy khai sinh. Nếu ngày sinh từ ngày 1 đến ngày
9, tháng sinh là tháng 1 đến tháng 2 thì ghi thêm số 0 phía trước; ghi năm sinh đầy đủ
04 chữ số, giữa ngày tháng năm có dấu gạch / (Ví dụ: 07/02/1981). In chữ font Times
New Roman, đậm (Bold),  kích cỡ (Size) 13, màu đen.
- (3) Ghi nơi sinh của người được cấp chứng chỉ theo địa danh tỉnh, thành phố trực
thuộc Trung ương căn cứ theo giấy khai sinh (kể cả trong trường hợp tại thời điểm cấp
chứng chỉ đã có sự thay đổi địa danh hành chính nên không còn địa danh tỉnh, thành
phố trực thuộc Trung ương khi khai sinh). In chữ font Times New Roman, đậm (Bold),
kích cỡ (Size) 13, màu đen.
- (4) Ghi tên Hội đồng thi. Nếu không thành lập Hội đồng thì không ghi. In chữ font
Times New Roman, đậm (Bold),  kích cỡ (Size) 13, màu đen.
- (5), (6) Ghi điểm thi của người được cấp chứng chỉ. In chữ font Times New Roman,
đậm (Bold),  kích cỡ (Size) 13, màu đen.
- (7) Ghi địa danh tỉnh, thành phố trực thuộc Trung ương nơi cơ quan cấp chứng chỉ đặt
trụ sở chính. In chữ font Times New Roman, đậm (Bold),  kích cỡ (Size) 13, màu đen.
- (8) Ghi ngày, tháng, năm cấp chứng chỉ. In chữ font Times New Roman, đậm (Bold),
kích cỡ (Size) 10, màu đen.
- (9) Ghi HIỆU TRƯỞNG hoặc Thủ trưởng cơ sở đào tạo được ủy quyền cấp chứng
chỉ. In chữ font Times New Roman, đậm (Bold),  kích cỡ (Size) 13, màu đen.
- (10) HIỆU TRƯỞNG hoặc Thủ trưởng cơ sở đào tạo được ủy quyền cấp chứng chỉ
ký, ghi rõ học hàm, học vị, họ tên và đóng dấu theo quy định.
- (11) Do cơ quan in phôi chứng chỉ ghi khi cấp phôi.
40
- (12) Ghi số vào sổ gốc cấp chứng chỉ. In chữ font Times New Roman, đậm (Bold),
kích cỡ (Size) 13, màu đen.
- (13) Ghi tên chương trình đào tạo ngắn hạn. In chữ font Times New Roman, đậm
(Bold),  kích cỡ (Size) 13, màu đen.
41
Phụ lục 21
Mẫu BẰNG TỐT NGHIỆP THẠC SĨ
và phương thức ghi nội dung trên văn bằng
(Ban hành kèm theo Quyết định số: 172/QĐ-ĐHCNTT,  ngày 08 tháng 3 năm 2023  của
Hiệu trưởng Trường Đại học Công nghệ Thông tin)""" ;
    uit:hasParent uit:dieu_ec8eaff8_31be_4977_bffd_19ed19cae63f ;
    uit:inDocument uit:Document_b61c9fab_9889_48b7_b2c5_8d7fb72f4110 ;
    uit:level "khoan" ;
    uit:ordinal 32002 ;
    uit:path "6/32/2" ;
    uit:soHieu "172/QD/DHCNTT" ;
    uit:title "Khoản 2" .

uit:khoan_65cd8bab_6a89_46de_92dc_82c8a9dfe69c a uit:Clause ;
    rdfs:label "Khoản 3" ;
    uit:clauseId "65cd8bab-6a89-46de-92dc-82c8a9dfe69c" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Các nội dung ghi trong bản sao văn bằng, chứng chỉ phải chính xác so với sổ gốc.
11""" ;
    uit:hasParent uit:dieu_dd2b7ab6_160b_4e0d_8e38_b6d64ea9785e ;
    uit:inDocument uit:Document_b61c9fab_9889_48b7_b2c5_8d7fb72f4110 ;
