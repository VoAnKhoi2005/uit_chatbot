    uit:title "Khoản 1" .

uit:khoan_56e142b6_fad1_4a9f_a09a_b71d1cd19dd0 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "56e142b6-fad1-4a9f-a09a-b71d1cd19dd0" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Đầu khoá học, Trường có trách nhiệm thông báo cho sinh viên về:
- Chương trình đào tạo toàn khóa cho từng ngành học.
- Quy chế học tập và các quy định của Trường.
- Quyền lợi và nghĩa vụ của sinh viên.""" ;
    uit:hasParent uit:dieu_1b59a948_7a3e_41bb_ad1d_5db04f885e79 ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
    uit:level "khoan" ;
    uit:ordinal 13001 ;
    uit:path "2/13/1" ;
    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Khoản 1" .

uit:khoan_56ec6d24_68df_44a2_873a_db581d507409 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "56ec6d24-68df-44a2-873a-db581d507409" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Thang đi ểm đánh giá và xếp loại 
Các lo ại điểm của học phần được đánh giá theo thang đi ểm 10. Các thang đi ểm khác 
chỉ mang tính tham kh ảo, chuy ển đổi khi c ần thiết. 
Bảng xếp loại và thang đi ểm tương ứng 
Loại Thang đi ểm 10 Thang đi ểm 100 Điểm 4 Điểm ch ữ Xếp loại 
Đạt 9,0 đ ến 10,0 Từ 90 đến 100 4,0 A+ Xuất sắc 
8,0 đ ến cận 9,0 Từ 80 đến cận 90 3,5 A Giỏi 
7,0 đ ến cận 8,0 Từ 70 đến cận 80 3,0 B+ Khá 
6,0 đ ến cận 7,0 Từ 60 đến cận 70 2,5 B Trung bình 
khá 
5,0 đ ến cận 6,0 Từ 50 đến cận 60 2,0 C Trung bình 
Không 
đạt 4,0 đ ến cận 5,0 Từ 40 đến cận 50 1,5 D+ Yếu 
3,0 đ ến cận 4,0 Từ 30 đến cận 40 1,0 D Kém 
Trang 19/27 
 < 3,0 Dưới 30 0,0 F""" ;
    uit:hasParent uit:dieu_fc9e533b_1ca1_4c0f_a8cd_a47b835368fd ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
    uit:level "khoan" ;
    uit:ordinal 21001 ;
    uit:path "1/55/1" ;
    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Khoản 1" .

uit:khoan_5701d4a9_8871_48f3_9ab4_6cc063a62383 a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "5701d4a9-8871-48f3-9ab4-6cc063a62383" ;
