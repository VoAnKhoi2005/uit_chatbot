uit:khoan_90eb97ca_2cb3_40cf_8793_8a23e6ae98cb a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "90eb97ca-2cb3-40cf-8793-8a23e6ae98cb" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText "Xếp lịch thi; lập các danh sách SV dự thi;" ;
    uit:hasParent uit:dieu_e013375a_0d4a_401d_a672_2f456869e331 ;
    uit:inDocument uit:Document_0cf30b50_fd07_4dc5_96fe_4b701c1e54ec ;
