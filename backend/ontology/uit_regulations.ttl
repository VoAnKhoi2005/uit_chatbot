uit:khoan_a6550737_3e5e_443b_9478_464eecd9d4a2 a uit:Clause ;
    rdfs:label "Khoản 3" ;
    uit:clauseId "a6550737-3e5e-443b-9478-464eecd9d4a2" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText """CBCT phổ biến quy chế, quy định, trách nhiệm của sinh viên dự thi (Điều 13 Quy định
này); giấy thi và giấy nháp của SV phải có đầy đủ chữ ký, ghi rõ họ tên của tất cả CBCT;
hướng dẫn và kiểm tra SV gấp giấy thi đúng quy cách, ghi số thứ tự và điền đủ vào các mục
cần thiết của giấy thi trước khi làm bài; ghi thông tin tên môn thi, thời gian thi và biểu đồ thời
gian lên bảng.""" ;
    uit:hasParent uit:dieu_894561d9_bc4e_4fd3_8cdd_412a0efc193b ;
    uit:inDocument uit:Document_0cf30b50_fd07_4dc5_96fe_4b701c1e54ec ;
    uit:level "khoan" ;
    uit:ordinal 12003 ;
    uit:path "2/12/3" ;
    uit:soHieu "1139" ;
    uit:title "Khoản 3" .

uit:khoan_a69df756_5c6d_4085_919e_2045ac93aadf a uit:Clause ;
    rdfs:label "Khoản 4" ;
    uit:clauseId "a69df756-5c6d-4085-919e-2045ac93aadf" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Văn bằng tiến sĩ:
Cách ghi là: QSCZZ9XXX
15
Trong đó:
- QSC: Mã trường
- ZZ: 02 số cuối của năm cấp bằng.
- 9: Viết tắt 1 ký số đầu mã ngành đào tạo tiến sĩ.
- XXX: số thứ tự người học tốt nghiệp trong năm ZZ thì phải nối tiếp nhau.""" ;
    uit:hasParent uit:dieu_ec8eaff8_31be_4977_bffd_19ed19cae63f ;
    uit:inDocument uit:Document_b61c9fab_9889_48b7_b2c5_8d7fb72f4110 ;
    uit:level "khoan" ;
    uit:ordinal 32004 ;
    uit:path "6/32/4" ;
    uit:soHieu "172/QD/DHCNTT" ;
    uit:title "Khoản 4" .

uit:khoan_a7330319_3839_4840_ab33_a69d0917c96e a uit:Clause ;
    rdfs:label "Khoản 3" ;
    uit:clauseId "a7330319-3839-4840-ab33-a69d0917c96e" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Sinh viên chính quy có kh ả năng b ị xử lý học vụ hình th ức buộc thôi h ọc có nguy ện vọng 
được chuy ển qua hình th ức đào t ạo không chính quy sẽ được xem xét chuy ển đổi. Những 
học phần sinh viên đã tích lũy được Trường xem xét công nh ận, chuy ển đổi tín ch ỉ.""" ;
    uit:hasParent uit:dieu_83ddd854_ed7f_46dd_86ef_ed876677d0a2 ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
    uit:level "khoan" ;
    uit:ordinal 10003 ;
    uit:path "1/44/3" ;
    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Khoản 3" .

uit:khoan_a735f64a_d619_4f99_8cc2_a0a536603fa4 a uit:Clause ;
    rdfs:label "Khoản 3" ;
    uit:clauseId "a735f64a-d619-4f99-8cc2-a0a536603fa4" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Đầu mỗi học kỳ, Trư ờng có trách nhi ệm thông báo cho sinh viên v ề: 
- Thời khóa biểu giảng dạy, học tập của học kỳ. 
- Danh mục các học phần và số lượng tín chỉ của mỗi học phần dự kiến giảng dạy 
trong học kỳ, điều kiện để đăng ký học các học phần đó. 
- Số lớp học dự kiến tổ chức cho mỗi học phần và thời khoá biểu cho các lớp học.""" ;
