    uit:soHieu "172/QD/DHCNTT" ;
    uit:title "Khoản 1" .

uit:khoan_de6df1fd_5516_4cd8_a94c_2a513910429d a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "de6df1fd-5516-4cd8-a94c-2a513910429d" ;
