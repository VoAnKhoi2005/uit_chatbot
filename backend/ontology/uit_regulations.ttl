uit:khoan_0631725a_340c_4a4d_974a_a606f25e0d36 a uit:Clause ;
    rdfs:label "Khoản 3" ;
    uit:clauseId "0631725a-340c-4a4d-974a-a606f25e0d36" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Học cải thiện điểm 
Đối với học phần có k ết quả đạt, sinh viên mu ốn phấn đấu đạt kết quả cao hơn (cải 
thiện điểm) phải đăng ký h ọc lại học phần đó theo quy đ ịnh sau: 
- Kết quả cao nhất trong các lần h ọc được chọn để tính vào ĐTB C, ĐTBCTL . Điểm 
của tất cả các lần học được lưu đầy đủ trong kết quả học tập của sinh viên. 
- Tổng số tín chỉ đăng ký học cải thiện ở học kỳ nào thì được tính vào tổng số tín chỉ 
đăng ký học ở học kỳ đó theo quy định tại Khoản 1 Điều 1 4 của Quy chế này.""" ;
    uit:hasParent uit:dieu_a154e908_2058_4895_9d03_f14e70cea6d4 ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
    uit:level "khoan" ;
    uit:ordinal 14003 ;
    uit:path "1/48/3" ;
    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Khoản 3" .

uit:khoan_06943aec_c04a_4c69_b506_899afdfa5804 a uit:Clause ;
    rdfs:label "Khoản 3" ;
    uit:clauseId "06943aec-c04a-4c69-b506-899afdfa5804" ;
    uit:docId "e4f0b05e-6ed8-47a8-b1d0-7722507d7b1f" ;
    uit:docTitle "159-Qd-Dhcntt 05-03-2024 Ban Hanh Quy Dinh Kltn" ;
    uit:fullText """CBPB phải khác với CBHD và không được là người có quan hệ ruột thịt (cha, mẹ, vợ,
chồng, anh, chị, em ruột) với SV.""" ;
    uit:hasParent uit:dieu_cc959c42_c0ac_4665_962d_97720d0731ec ;
    uit:inDocument uit:Document_e4f0b05e_6ed8_47a8_b1d0_7722507d7b1f ;
    uit:level "khoan" ;
