uit:khoan_9ac655d7_9889_4cc5_8c50_76ee6e4dfed7 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "9ac655d7-9889-4cc5-8c50-76ee6e4dfed7" ;
    uit:docId "4ad990e5-085f-4143-a5a5-11dc31e82ec5" ;
    uit:docTitle "141-Qd-Dhcntt16-3-2018Quy Dinh Dao Tao Ngoai Ngu Doi Voi He Dh Chinh Quy Cua Truong Dhcntt Ap Dung Tu Khoa 2017 0" ;
    uit:fullText """Môn học TACM đáp ứng các yêu cầu sau:
a. Là các môn học thuộc khối kiến thức cơ bản, cơ sở hoặc chuyên ngành được giảng dạy
chủ yếu bằng tiếng Anh. Nội dung giảng dạy hoàn toàn giống môn học được giảng dạy bằng
tiếng Việt.
b. Cán bộ giảng dạy (CBGD) lý thuyết phải giảng bằng tiếng Anh.
c. Tài liệu giảng dạy và giáo trình chính của môn học bằng tiếng Anh.""" ;
    uit:hasParent uit:dieu_e2185431_f230_425d_b783_71869ff16404 ;
    uit:inDocument uit:Document_4ad990e5_085f_4143_a5a5_11dc31e82ec5 ;
