uit:khoan_15dd7847_ac27_459b_a687_aa3d6ae0a2a4 a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "15dd7847-ac27-459b-a687-aa3d6ae0a2a4" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Sinh viên được quyền xin tạm dừng học tập và được bảo lưu kết quả học tập trong các
trường hợp sau:
- Được cơ quan có thẩm quyền điều động, đại diện quốc gia tham dự các kỳ thi, giải
đấu quốc tế.
- Bị ốm, thai sản hoặc tai nạn phải điều trị thời gian dài, có chứng nhận của cơ sở
khám bệnh, chữa bệnh có thẩm quyền theo quy định của Bộ Y tế.
Trang 16/27
- Trường hợp vì lý do cá nhân, sinh viên phải học ít nhất một học kỳ ở Trường và
không rơi vào các trường hợp bị đình chỉ học tập, có xác nhận của gia đình và giấy tờ
liên quan hợp lệ.""" ;
    uit:hasParent uit:dieu_f07f372e_a760_45df_9c1d_f0e7f166c36b ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
