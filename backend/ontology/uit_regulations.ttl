uit:khoan_6aaff650_1d26_49e9_a67a_6635c3d9379a a uit:Clause ;
    rdfs:label "Khoản 3" ;
    uit:clauseId "6aaff650-1d26-49e9-a67a-6635c3d9379a" ;
