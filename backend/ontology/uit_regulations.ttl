uit:khoan_4868460a_7ef2_48a2_bd86_f2eb99033de0 a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "4868460a-7ef2-48a2-bd86-f2eb99033de0" ;
