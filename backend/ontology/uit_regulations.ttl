    uit:title "Khoản 1" .

uit:khoan_138b9c09_2b81_442e_b58a_c64d47834bc8 a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "138b9c09-2b81-442e-b58a-c64d47834bc8" ;
    uit:docId "e078682d-57d3-420b-924b-5411aee851f3" ;
    uit:docTitle "128-Qd-Dhcntt-Dtdh 30-8-2016 Ban Hanh Qd Day Va Hoc Nn Doi Voi He Dai Hoc Cq Cua Truong Dhcntt Khoa 2016" ;
    uit:fullText """Tương ứng với 2 phương thức tổ chức lớp ở Khoản 1 của điều này, có 2 phương thức thu
học phí:
a. Phương thức 1: Học phí được thu theo quy định thu học phí của chương trình đào tạo hệ
đại học chính quy.
b. Phương thức 2: Học phí được thu theo mức riêng tương ứng với chi phí đào tạo do Hiệu
trưởng quy định.
4""" ;
    uit:hasParent uit:dieu_ea0199bb_18eb_41b8_aa29_3d647c21d64c ;
