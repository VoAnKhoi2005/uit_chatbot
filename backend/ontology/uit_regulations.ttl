    uit:path "1/3/2" ;
    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Khoản 2" .

uit:khoan_60feb9ff_c199_4ce8_bb18_735302ea7e20 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "60feb9ff-c199-4ce8-bb18-735302ea7e20" ;
    uit:docId "c9cbb5b3-7c97-4baf-b5ce-6803d6ef5f3a" ;
    uit:docTitle "507-Qd-Dhcntt-27-5-2024 Quy Che Dao Tao Cho Sinh Vien" ;
    uit:fullText "Sinh viên được phép đăng ký học những môn học được mở trong học kỳ." ;
    uit:hasParent uit:dieu_aabeabca_14e6_43e2_9d64_d080de1c1761 ;
