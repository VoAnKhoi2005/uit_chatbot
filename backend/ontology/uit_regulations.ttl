uit:khoan_f1dd9a69_5312_4505_b1ac_d95276a74d46 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "f1dd9a69-5312-4505-b1ac-d95276a74d46" ;
    uit:docId "c9cbb5b3-7c97-4baf-b5ce-6803d6ef5f3a" ;
    uit:docTitle "507-Qd-Dhcntt-27-5-2024 Quy Che Dao Tao Cho Sinh Vien" ;
    uit:fullText """Cảnh báo học vụ: Sinh viên bị cảnh báo học tập nếu thuộc một trong những trường hợp
sau:
- Không đóng học phí theo quy định;
- Không dự kiểm tra/thi kết thúc môn học quá 30% số môn học đăng ký trong năm
học;
10""" ;
    uit:hasParent uit:dieu_e532ac34_252a_4b2c_bd63_18cf78552dec ;
    uit:inDocument uit:Document_c9cbb5b3_7c97_4baf_b5ce_6803d6ef5f3a ;
    uit:level "khoan" ;
    uit:ordinal 16001 ;
    uit:path "2/16/1" ;
    uit:soHieu "507/QD/DHCNTT/27/5/2024" ;
    uit:title "Khoản 1" .

uit:khoan_f2141ff7_71c5_463f_a9f5_a5856d419a84 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "f2141ff7-71c5-463f-a9f5-a5856d419a84" ;
    uit:docId "c9cbb5b3-7c97-4baf-b5ce-6803d6ef5f3a" ;
    uit:docTitle "507-Qd-Dhcntt-27-5-2024 Quy Che Dao Tao Cho Sinh Vien" ;
    uit:fullText """Học phí được thu theo từng học kỳ và được tính theo công thức sau:
Học phí = HPTCHM × TCHPHM + HPTCHL × TCHPHL + HPTCCT × TCHPCT
Trong đó:
- HPTCHM: mức học phí cho loại tín chỉ học phí học mới.
- TCHPHM: tổng số tín chỉ học phí của các môn học mới.
- HPTCHL: mức học phí cho loại tín chỉ học phí học lại.
- TCHPHL: tổng số tín chỉ học phí của các môn học lại.
- HPTCCT: mức học phí cho loại tín chỉ học phí học cải thiện.
- TCHPCT: tổng số tín chỉ học phí của các môn học cải thiện.
Vào đầu khóa học hoặc năm học, Trường công bố mức học phí cho mỗi loại tín chỉ học
phí.""" ;
    uit:hasParent uit:dieu_e6f6a00f_b1ea_48d8_9a08_6b4db8fa68db ;
    uit:inDocument uit:Document_c9cbb5b3_7c97_4baf_b5ce_6803d6ef5f3a ;
    uit:level "khoan" ;
    uit:ordinal 11001 ;
    uit:path "2/11/1" ;
    uit:soHieu "507/QD/DHCNTT/27/5/2024" ;
    uit:title "Khoản 1" .

uit:khoan_f296c349_775b_4072_8a0c_c4dd20d3d527 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "f296c349-775b-4072-8a0c-c4dd20d3d527" ;
    uit:docId "65b3de70-0d5b-43ee-a4d9-93a1ef996b58" ;
    uit:docTitle "125-Qd-Dhcntt-Dtdh 18-09-2015 Quyet Dinh Ban Hanh Qui Dinh Tam Thoi Day Va Hoc Tieng Anh Khoa 2015 0" ;
    uit:fullText """Củng cố toàn diện 4 kỹ năng sử dụng tiếng Anh tổng quát: nghe, nói, đọc, viết; và phát
triển kỹ năng sử dụng tiếng Anh chuyên ngành ở trình độ phù hợp với trình độ đào tạo và
ngành đào tạo.""" ;
    uit:hasParent uit:dieu_ca88235e_3193_4152_83fd_06859ca35130 ;
    uit:inDocument uit:Document_65b3de70_0d5b_43ee_a4d9_93a1ef996b58 ;
