    uit:title "Điểm b)" .

uit:diem_0ee3a399_3105_4c00_bb71_c65a6c772631 a uit:Entity ;
    rdfs:label "Điểm d)" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText """Phải kiểm tra đề thi để đảm bảo: đề thi có đủ số lượng câu trắc nghiệm như đã ghi
trong đề; nội dung đề được in rõ ràng, không thiếu chữ, mất nét; tất cả các trang của đề thi
đều ghi cùng một mã đề thi. Nếu có những chi tiết bất thường trong đề thi, hoặc có 2 đề
thi trở lên, SV phải báo ngay cho CBCT để xử lý;""" ;
    uit:hasParent uit:khoan_9eed8eee_ced0_442d_b78a_49c296037970 ;
    uit:inDocument uit:Document_0cf30b50_fd07_4dc5_96fe_4b701c1e54ec ;
    uit:level "diem" ;
    uit:ordinal 1.300304e+04 ;
    uit:path "2/13/3/d" ;
    uit:soHieu "1139" ;
    uit:title "Điểm d)" .

uit:diem_110679d3_db51_4029_b91e_34658b8db4f6 a uit:Entity ;
    rdfs:label "Điểm b)" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Căn c ứ chương trình môn h ọc và k ết quả trên b ảng đi ểm học tập của sinh viên, Hi ệu 
trưởng quy ết định vi ệc công nh ận kết quả học tập, kh ối lượng ki ến thức và các môn 
học cần phải bổ sung.""" ;
    uit:hasParent uit:khoan_c9056171_9028_4298_8255_a252748ff5b1 ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
