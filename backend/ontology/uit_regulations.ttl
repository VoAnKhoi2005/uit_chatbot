    uit:ordinal 2.600201e+04 ;
    uit:path "1/60/2/a" ;
    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Điểm a)" .

uit:diem_5f01a54b_95b6_48c5_91fd_f7b21ac0629b a uit:Entity ;
    rdfs:label "Điểm b)" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Ngay trong ngày tiếp nhận yêu cầu hoặc trong ngày làm việc tiếp theo (nếu tiếp
nhận yêu cầu sau 15 giờ), cơ quan có thẩm quyền cấp bản sao từ sổ gốc phải cấp bản sao cho
12
người có yêu cầu. Trong trường hợp yêu cầu cấp bản sao từ sổ gốc được gửi qua bưu điện thì
thời hạn được xác định từ thời điểm cơ quan có thẩm quyền cấp bản sao từ sổ gốc nhận đủ
hồ sơ hợp lệ theo dấu bưu điện đến.""" ;
    uit:hasParent uit:khoan_9a3818f1_f96a_4dda_9183_a887b0af2179 ;
    uit:inDocument uit:Document_b61c9fab_9889_48b7_b2c5_8d7fb72f4110 ;
    uit:level "diem" ;
    uit:ordinal 2.700202e+04 ;
    uit:path "5/27/2/b" ;
    uit:soHieu "172/QD/DHCNTT" ;
    uit:title "Điểm b)" .

uit:diem_6163d2d0_6383_413c_af0f_6883d79afbf4 a uit:Entity ;
    rdfs:label "Điểm h)" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText """SV chỉ được ra khỏi phòng thi sau 2/3 thời gian làm bài và sau khi đã nộp bài làm và
đề thi cho CBCT, trừ trường hợp ốm đau cần cấp cứu do CB trực lãnh đạo thi quyết định.""" ;
    uit:hasParent uit:khoan_7f68e490_95db_4138_a464_b3390bad3b0f ;
    uit:inDocument uit:Document_0cf30b50_fd07_4dc5_96fe_4b701c1e54ec ;
