uit:khoan_3db5f7c6_4c32_45a9_af16_e786ba81e448 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "3db5f7c6-4c32-45a9-af16-e786ba81e448" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Quy chế này quy định những điều chung nhất về đào tạo đại học theo hình thức chính
quy (gọi tắt là hệ đại học chính quy) của Trường Đại học Công nghệ Thông tin thuộc
ĐHQG-HCM (gọi tắt là Trường).""" ;
    uit:hasParent uit:dieu_bcb1b4ba_fc18_4577_9ee1_dfb5c632bc9f ;
