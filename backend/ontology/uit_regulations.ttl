uit:dieu_c2ec80d0_896d_470d_a95b_56f68a373ddf a uit:Article ;
    rdfs:label "Điều 9" ;
    uit:articleId "c2ec80d0-896d-470d-a95b-56f68a373ddf" ;
    uit:docId "e078682d-57d3-420b-924b-5411aee851f3" ;
    uit:docTitle "128-Qd-Dhcntt-Dtdh 30-8-2016 Ban Hanh Qd Day Va Hoc Nn Doi Voi He Dai Hoc Cq Cua Truong Dhcntt Khoa 2016" ;
    uit:fullText """CBGD phải đáp ứng yêu cầu theo quy định chung của Trường; ngoài ra, CBGD lý thuyết phải
đáp ứng thêm một trong các yêu cầu sau đây:
a. Có trình độ tiếng Anh tối thiểu tương đương cấp độ C1 tham chiếu theo khung Châu Âu
(CEFR).
b. Tốt nghiệp một trường đại học nước ngoài, có sử dụng tiếng Anh trong quá trình học tập
(có môn học bằng tiếng Anh, hoặc luận án tốt nghiệp được viết bằng tiếng Anh).
c. Tốt nghiệp một trường đại học trong nước theo chương trình đào tạo sử dụng 100% tiếng
Anh.""" ;
    uit:hasClause uit:khoan_2037c4fb_a118_4df1_8c8a_5963ba1e2f29 ;
    uit:hasParent uit:chuong_0642a1aa_784f_41dc_9dd8_4ad1def279c9 ;
    uit:heading "Yêu cầu về cán bộ giảng dạy" ;
    uit:inDocument uit:Document_e078682d_57d3_420b_924b_5411aee851f3 ;
    uit:level "dieu" ;
    uit:ordinal 3009 ;
    uit:path "3/9" ;
