uit:khoan_585b6a51_b3a2_455a_9cfb_d0cbd6565167 a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "585b6a51-b3a2-455a-9cfb-d0cbd6565167" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText """Trước giờ thi 10 phút, tại phòng thi, các CBCT phải hoàn tất đánh số chỗ ngồi theo
danh sách (dùng số thứ tự SV trong danh sách để đánh số) – tuyệt đối không để SV tự sắp
chỗ trong phòng thi. Trong thời gian coi thi, CBCT kiểm tra giấy tờ chứng minh cá nhân hợp
lệ, đối chiếu hình, đối chiếu tên với danh sách dự thi. CBCT không được cho vào phòng thi
các SV không có tên trong danh sách và cũng không có giấy vào phòng thi được cấp bởi
P.ĐTĐH. Nếu SV có khiếu nại, CBCT hướng dẫn SV tới ngay P.ĐTĐH để xác minh giải
quyết. CBCT lưu ý thu lại giấy vào phòng thi của SV để bàn giao cùng túi bài thi.""" ;
    uit:hasParent uit:dieu_894561d9_bc4e_4fd3_8cdd_412a0efc193b ;
    uit:inDocument uit:Document_0cf30b50_fd07_4dc5_96fe_4b701c1e54ec ;
    uit:level "khoan" ;
    uit:ordinal 12002 ;
    uit:path "2/12/2" ;
    uit:soHieu "1139" ;
    uit:title "Khoản 2" .

uit:khoan_5873979d_7a20_431a_9799_d8ceca257176 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "5873979d-7a20-431a-9799-d8ceca257176" ;
    uit:docId "4ad990e5-085f-4143-a5a5-11dc31e82ec5" ;
    uit:docTitle "141-Qd-Dhcntt16-3-2018Quy Dinh Dao Tao Ngoai Ngu Doi Voi He Dh Chinh Quy Cua Truong Dhcntt Ap Dung Tu Khoa 2017 0" ;
    uit:fullText """Văn bản này quy định về đào tạo ngoại ngữ đối với các chương trình đào tạo hệ đại học
chính quy của Trường Đại học Công nghệ Thông tin (gọi tắt là Trường) bao gồm: chương
trình giảng dạy, kiểm tra xếp lớp đầu khóa, xét miễn học các môn học tiếng Anh, chuẩn quá
trình, chuẩn ngoại ngữ xét tốt nghiệp và tổ chức giảng dạy các môn học chuyên ngành bằng
tiếng Anh.""" ;
    uit:hasParent uit:dieu_df44ca28_329e_4602_b36a_c6b6d5c54437 ;
    uit:inDocument uit:Document_4ad990e5_085f_4143_a5a5_11dc31e82ec5 ;
    uit:level "khoan" ;
    uit:ordinal 1001 ;
    uit:path "1/1/1" ;
    uit:soHieu "141/QD/DHCNTT16/3/2018QUY" ;
    uit:title "Khoản 1" .

