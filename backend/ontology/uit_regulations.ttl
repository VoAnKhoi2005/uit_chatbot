uit:khoan_5de88056_76d4_4106_b1bd_eb0c6efc0ef7 a uit:Clause ;
    rdfs:label "Khoản 3" ;
    uit:clauseId "5de88056-76d4-4106-b1bd-eb0c6efc0ef7" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Điểm trung bình chung tích lũy (ĐTBCTL) là đi ểm trung bình c ủa các h ọc phần mà sinh 
viên đã đăng ký h ọc từ lúc b ắt đầu khóa h ọc đến thời điểm đư ợc tính với trọng số là số 
tín ch ỉ đã đư ợc tích lũy (đạt từ 5,0 đi ểm trở lên) của mỗi học phần (đư ợc tính theo đi ểm 
học phần cao nh ất trong các l ần học). ĐTB CTL đư ợc tính khi sinh viên đ ủ điều kiện tốt 
nghiệp, đư ợc dùng đ ể phân lo ại kết quả học tập và x ếp hạng tốt nghi ệp.""" ;
    uit:hasParent uit:dieu_dd1bdf30_3f94_4983_bc4e_aadb7cf867f1 ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
