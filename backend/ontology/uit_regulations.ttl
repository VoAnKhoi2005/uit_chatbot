    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Khoản 3" .

uit:khoan_f14d24ca_cf75_4d7a_9103_273d33064ed1 a uit:Clause ;
    rdfs:label "Khoản 4" ;
    uit:clauseId "f14d24ca-cf75-4d7a-9103-273d33064ed1" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Thời gian tối đa được phép học đối với sinh viên học cùng lúc hai chương trình là thời
gian tối đa quy định cho chương trình thứ nhất, quy định tại Điều 6 của Quy chế này.
Khi học chương trình thứ hai, sinh viên được công nhận kết quả của những học phần
có nội dung và khối lượng kiến thức tương đương có trong chương trình thứ nhất.""" ;
    uit:hasParent uit:dieu_747258cf_4eef_4e8d_9074_4ecfa514656d ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
