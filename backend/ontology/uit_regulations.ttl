uit:khoan_439f1814_5c9b_446e_b7cb_22c72ed13dac a uit:Clause ;
    rdfs:label "Khoản 3" ;
    uit:clauseId "439f1814-5c9b-446e-b7cb-22c72ed13dac" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Sinh viên chính quy có khả năng bị xử lý học vụ hình thức buộc thôi học có nguyện vọng
được chuyển qua hình thức đào tạo không chính quy sẽ được xem xét chuyển đổi. Những
học phần sinh viên đã tích lũy được Trường xem xét công nhận, chuyển đổi tín chỉ.""" ;
    uit:hasParent uit:dieu_28c0b3c3_66e6_467e_8df9_3caec6b6d8bc ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
