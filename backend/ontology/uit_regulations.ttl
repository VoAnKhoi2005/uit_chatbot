uit:khoan_6013e994_c434_42e5_a164_0f1588f115c5 a uit:Clause ;
    rdfs:label "Khoản 3" ;
    uit:clauseId "6013e994-c434-42e5-a164-0f1588f115c5" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Nếu được nhận điểm I, trong th ời gian t ối đa là 2 h ọc kỳ chính ti ếp theo, sinh viên ph ải 
làm đơn đăng ký thi l ại học phần đó. Sau khi thi, đi ểm I được điều chỉnh thành đi ểm mà 
sinh viên đ ạt được. Ngư ợc lại, nếu sinh viên không đăng ký thi l ại sau hai h ọc kỳ chính 
tiếp theo thì đi ểm I được điều chỉnh thành đi ểm không (0).""" ;
    uit:hasParent uit:dieu_49fdab7a_823f_4b91_961a_64dafe49403d ;
