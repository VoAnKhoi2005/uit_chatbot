    uit:title "Khoản 6" .

uit:khoan_f7c05c8b_6729_42c8_8ce4_5b15f4ebb7c3 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "f7c05c8b-6729-42c8-8ce4-5b15f4ebb7c3" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText "Lập kế hoạch và điều hành công tác tổ chức thi." ;
    uit:hasParent uit:dieu_e013375a_0d4a_401d_a672_2f456869e331 ;
