    uit:fullText """Trường có trách nhi ệm cấp giấy chứng nh ận kết quả môn h ọc của sinh viên khi hoàn t ất 
quá trình h ọc tập theo quy đ ịnh.""" ;
    uit:hasParent uit:dieu_8c3102af_5850_4962_80a6_94743cdb515d ;
