uit:khoan_ec83fd47_558e_415a_a9c1_a27607610260 a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "ec83fd47-558e-415a-a9c1-a27607610260" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Điểm trung bình chung (ĐTBC) là điểm trung bình của các học phần mà sinh viên đã
đăng ký học từ lúc bắt đầu khóa học đến thời điểm được tính với trọng số là số tín chỉ
của mỗi học phần (được tính theo điểm học phần cao nhất trong các lần học, bao gồm cả
những học phần không đạt). ĐTBC được dùng để xét số tín chỉ được phép đăng ký trong
học kỳ, học vượt, xét chuyển ngành/chương trình, xét điều kiện làm khóa luận tốt
nghiệp.""" ;
    uit:hasParent uit:dieu_8b688d0b_c2b6_4aba_b775_593997cdd308 ;
