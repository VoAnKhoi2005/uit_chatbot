    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText "Đơn đề nghị chỉnh sửa văn bằng, chứng chỉ có chữ ký của người được cấp;" ;
    uit:hasParent uit:khoan_f5c8033d_4ef1_4605_9045_dacd5ed4e89a ;
