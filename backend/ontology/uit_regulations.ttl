uit:khoan_92a13b23_28bc_4646_ae5b_4b6c44503594 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "92a13b23-28bc-4646-ae5b-4b6c44503594" ;
    uit:docId "4ad990e5-085f-4143-a5a5-11dc31e82ec5" ;
    uit:docTitle "141-Qd-Dhcntt16-3-2018Quy Dinh Dao Tao Ngoai Ngu Doi Voi He Dh Chinh Quy Cua Truong Dhcntt Ap Dung Tu Khoa 2017 0" ;
    uit:fullText """Quy định này áp dụng bắt buộc cho các khóa tuyển sinh từ năm 2017. Các khóa tuyển sinh
trước năm 2017 có thể lựa chọn áp dụng quy định này hoặc quy định được ban hành trước
đó.""" ;
    uit:hasParent uit:dieu_f60bf74a_a20e_40ee_827a_5d373a150136 ;
    uit:inDocument uit:Document_4ad990e5_085f_4143_a5a5_11dc31e82ec5 ;
