uit:diem_15f618db_d783_43ff_bd76_b90c990a96c8 a uit:Entity ;
    rdfs:label "Điểm c)" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Đối với trường hợp cùng một lúc yêu cầu chứng thực bản sao từ nhiều sổ gốc, yêu
cầu số lượng nhiều bản sao, nội dung văn bằng phức tạp khó kiểm tra, đối chiếu mà cơ quan
có thẩm quyền cấp bản sao từ sổ gốc không thể đáp ứng được thời hạn quy định tại điểm b
khoản này thì thời hạn cấp bản sao được kéo dài thêm không quá 02 (hai) ngày làm việc hoặc
có thể dài hơn theo thỏa thuận bằng văn bản với người yêu cầu cấp bản sao.""" ;
    uit:hasParent uit:khoan_9a3818f1_f96a_4dda_9183_a887b0af2179 ;
    uit:inDocument uit:Document_b61c9fab_9889_48b7_b2c5_8d7fb72f4110 ;
    uit:level "diem" ;
    uit:ordinal 2.700203e+04 ;
    uit:path "5/27/2/c" ;
    uit:soHieu "172/QD/DHCNTT" ;
    uit:title "Điểm c)" .

uit:diem_1f71d365_0992_43e8_a457_75596142b48b a uit:Entity ;
    rdfs:label "Điểm c)" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText "Trước khi làm bài thi phải ghi đầy đủ họ tên, MSSV vào giấy thi, giấy nháp;" ;
    uit:hasParent uit:khoan_7f68e490_95db_4138_a464_b3390bad3b0f ;
