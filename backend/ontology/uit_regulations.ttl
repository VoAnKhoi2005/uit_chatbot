    uit:title "Khoản 3" .

uit:khoan_a502bc72_55a4_4de0_830f_35730eee6bd9 a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "a502bc72-55a4-4de0-830f-35730eee6bd9" ;
    uit:docId "c9cbb5b3-7c97-4baf-b5ce-6803d6ef5f3a" ;
    uit:docTitle "507-Qd-Dhcntt-27-5-2024 Quy Che Dao Tao Cho Sinh Vien" ;
    uit:fullText """Đình chỉ học tập:
- Sinh viên bị đình chỉ học tập 1 học kỳ chính nếu vi phạm lần đầu trong việc đi thi
hộ hoặc nhờ người thi hộ.
- Đình chỉ học tập có thời hạn: áp dụng đối với những sinh viên đang trong thời gian
bị cảnh báo mà vẫn vi phạm kỷ luật hoặc vi phạm nghiêm trọng các hành vi sinh
viên không được làm; sinh viên vi phạm pháp luật bị xử phạt tù nhưng cho hưởng
án treo.""" ;
    uit:hasParent uit:dieu_e532ac34_252a_4b2c_bd63_18cf78552dec ;
    uit:inDocument uit:Document_c9cbb5b3_7c97_4baf_b5ce_6803d6ef5f3a ;
    uit:level "khoan" ;
    uit:ordinal 16002 ;
    uit:path "2/16/2" ;
    uit:soHieu "507/QD/DHCNTT/27/5/2024" ;
    uit:title "Khoản 2" .

uit:khoan_a52fd3e8_ac96_414a_a84d_d05bbe591b9c a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "a52fd3e8-ac96-414a-a84d-d05bbe591b9c" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Đi ểm trung bình h ọc kỳ (ĐTBHK) là điểm trung bình c ủa các h ọc phần mà sinh viên đã 
đăng ký học trong h ọc kỳ đó với trọng số là số tín ch ỉ của mỗi học phần (bao g ồm cả 
những học phần không đ ạt). ĐTBHK đư ợc dùng đ ể xét h ọc bổng, khen thư ởng, x ử lý 
học vụ sau m ỗi học kỳ.""" ;
    uit:hasParent uit:dieu_dd1bdf30_3f94_4983_bc4e_aadb7cf867f1 ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
    uit:level "khoan" ;
    uit:ordinal 24001 ;
    uit:path "1/58/1" ;
    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Khoản 1" .

uit:khoan_a53d34ae_15a1_4970_880b_320ea2cc1d88 a uit:Clause ;
    rdfs:label "Khoản 4" ;
    uit:clauseId "a53d34ae-15a1-4970-880b-320ea2cc1d88" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Sinh viên và năm học: Sinh viên năm thứ k (tính từ thời điểm sinh viên bắt đầu học) của
một ngành và khóa học được xác định như sau: đạt số tín chỉ tích lũy n (theo đúng
chương trình đào tạo tương ứng tại thời điểm đang xét) thỏa điều kiện: (k-1) × 30 ≤ n < k
× 30.""" ;
    uit:hasParent uit:dieu_28c0b3c3_66e6_467e_8df9_3caec6b6d8bc ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
    uit:level "khoan" ;
    uit:ordinal 10004 ;
    uit:path "2/10/4" ;
    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Khoản 4" .

uit:khoan_a56ffafc_aa2e_4a85_9ad5_0c64cf8aa7eb a uit:Clause ;
    rdfs:label "Khoản 8" ;
    uit:clauseId "a56ffafc-aa2e-4a85-9ad5-0c64cf8aa7eb" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText "Trước khi hết giờ làm bài 15 phút CBCT thông báo thời gian còn lại cho SV biết;" ;
    uit:hasParent uit:dieu_894561d9_bc4e_4fd3_8cdd_412a0efc193b ;
