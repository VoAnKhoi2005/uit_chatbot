uit:khoan_504b4e7d_6342_42e0_a737_cc8609e6eb07 a uit:Clause ;
    rdfs:label "Khoản 3" ;
    uit:clauseId "504b4e7d-6342-42e0-a737-cc8609e6eb07" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Đối với các học phần đã đăng ký học, sinh viên có trách nhiệm thực hiện đầy đủ và
nghiêm túc mọi yêu cầu của cán bộ giảng dạy về việc lên lớp, làm bài tập, thực hành, thí
nghiệm, tham gia thảo luận, dự kiểm tra giữa học phần và kết thúc học phần. Trong trường
hợp sinh viên có lý do chính đáng (ốm đau, tai nạn, việc gia đình đột xuất,…) không thể
tham dự thi giữa kỳ thì làm đơn trình bày cùng các minh chứng, P.ĐTĐH xem xét và nếu
hợp lệ sinh viên được phép dùng điểm cuối kỳ thay cho điểm giữa kỳ.""" ;
    uit:hasParent uit:dieu_125883d9_3a0c_4dd8_bb6d_4fa3e2c0d3cc ;
