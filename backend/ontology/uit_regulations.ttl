uit:diem_e62cb1d0_2405_42db_b399_0a9077bad05e a uit:Entity ;
    rdfs:label "Điểm f)" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText """Nếu cần hỏi CBCT điều gì phải hỏi công khai. Phải giữ gìn trật tự, im lặng trong phòng
thi. Trường hợp ốm đau bất thường phải báo cáo để CBCT xử lý;""" ;
    uit:hasParent uit:khoan_7f68e490_95db_4138_a464_b3390bad3b0f ;
