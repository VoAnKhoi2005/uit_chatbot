    uit:fullText """Sinh viên t ạm dừng học tập, khi mu ốn trở lại học tiếp tại Trư ờng ph ải hoàn t ất thủ tục 
nhập học theo quy đ ịnh của Trư ờng.""" ;
    uit:hasParent uit:dieu_cdd3b6cc_4739_44ba_9dc6_8bcf98cf95d4 ;
