    uit:path "2/7" ;
    uit:soHieu "172/QD/DHCNTT" ;
    uit:title "Điều 7" .

uit:dieu_231b02e5_befd_455d_8837_6b8467b74313 a uit:Article ;
    rdfs:label "Điều 11" ;
    uit:articleId "231b02e5-befd-455d-8837-6b8467b74313" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Sau khi đư ợc xét trúng tuy ển vào Trư ờng, do m ột số hoàn c ảnh đặc biệt như đư ợc điều 
động vào các l ực lượng vũ trang, thai s ản, bệnh tật, tai n ạn, hoàn c ảnh khó khăn x ảy ra đ ột 
xuất, thí sinh trúng tuy ển có th ể xin b ảo lưu k ết quả. Thí sinh trúng tuy ển phải nộp đơn xin 
bảo lưu ch ậm nh ất 15 ngày k ể từ ngày g ọi nhập học cho P. ĐTĐH c ủa Trư ờng và ch ỉ được 
bảo lưu khi có quy ết định ch ấp thu ận của Hiệu trư ởng. 
Thời gian b ảo lưu k ết quả trúng tuy ển không quá 01 năm. Đối với trường hợp đư ợc 
điều động vào các l ực lượng vũ tran g thì th ời gian b ảo lưu k ết quả trúng tuy ển bằng với thời 
Trang 12/27 
 gian đư ợc điều động. Muốn nh ập học lại, thí sinh ph ải làm đơn xin nh ập học và nộp P. 
ĐTĐH của Trư ờng trư ớc khi b ắt đầu học kỳ ít nhất 1 tháng đ ể được giải quy ết. 
""" ;
    uit:hasClause uit:khoan_e5640be4_9dac_418a_b5e8_88327200414e ;
    uit:hasParent uit:chuong_d285d5aa_a986_4d7b_abb3_fd301bfb9f60 ;
    uit:heading "Bảo lưu kết quả trúng tuyển" ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
    uit:level "dieu" ;
    uit:ordinal 46 ;
    uit:path "1/45" ;
    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Điều 11" .

