    rdfs:label "Khoản 5" ;
    uit:clauseId "bc057ab0-7f74-4127-b035-9acc2c0932bd" ;
    uit:docId "c9cbb5b3-7c97-4baf-b5ce-6803d6ef5f3a" ;
    uit:docTitle "507-Qd-Dhcntt-27-5-2024 Quy Che Dao Tao Cho Sinh Vien" ;
    uit:fullText """Những sinh viên đã hết thời hạn tối đa được phép học nhưng không đủ điều kiện cấp
bằng tốt nghiệp hoặc đã thôi học được đề nghị Trường cấp giấy chứng nhận kết quả học
tập của các học phần đã tích lũy trong quá trình học tại Trường.""" ;
    uit:hasParent uit:dieu_0fbfd418_6497_4b24_a75f_8c790ab44a5e ;
    uit:inDocument uit:Document_c9cbb5b3_7c97_4baf_b5ce_6803d6ef5f3a ;
    uit:level "khoan" ;
    uit:ordinal 22005 ;
    uit:path "3/22/5" ;
    uit:soHieu "507/QD/DHCNTT/27/5/2024" ;
    uit:title "Khoản 5" .

uit:khoan_bc15f34d_2c37_4fdd_917e_2a5dcdad8e65 a uit:Clause ;
    rdfs:label "Khoản 3" ;
    uit:clauseId "bc15f34d-2c37-4fdd-917e-2a5dcdad8e65" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Đối với đào tạo theo hình thức chính quy, tối đa 30% tổng khối lượng của chương trình
đào tạo được thực hiện bằng phương thức qua mạng. Trong trường hợp thiên tai, dịch
bệnh phức tạp và các trường hợp bất khả kháng khác, Trường thực hiện theo hướng dẫn
của Bộ Giáo dục và Đào tạo và của ĐHQG-HCM.""" ;
    uit:hasParent uit:dieu_b54b7d4b_e110_4024_80c3_33b3d016425f ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
