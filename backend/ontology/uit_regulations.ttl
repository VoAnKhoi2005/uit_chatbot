uit:khoan_1572d67f_551d_4d18_a55c_c4921e67e07b a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "1572d67f-551d-4d18-a55c-c4921e67e07b" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Người có thẩm quyền quyết định chỉnh sửa nội dung văn bằng, chứng chỉ là Hiệu
trưởng hoặc thủ trưởng đơn vị được ủy quyền cấp chứng chỉ. Trường hợp Trường đã sáp
nhập, chia, tách, giải thể hoặc có sự điều chỉnh về thẩm quyền thì người có thẩm quyền quyết
định chỉnh sửa nội dung văn bằng, chứng chỉ là thủ trưởng cơ quan đang quản lý sổ gốc cấp
văn bằng, chứng chỉ.""" ;
    uit:hasParent uit:dieu_716672fe_7b21_432e_b78c_563235552e95 ;
    uit:inDocument uit:Document_b61c9fab_9889_48b7_b2c5_8d7fb72f4110 ;
    uit:level "khoan" ;
    uit:ordinal 18001 ;
    uit:path "4/18/1" ;
    uit:soHieu "172/QD/DHCNTT" ;
    uit:title "Khoản 1" .

