uit:khoan_68652ef3_c18b_46c3_b837_6c6565f9ee9e a uit:Clause ;
    rdfs:label "Khoản 6" ;
    uit:clauseId "68652ef3-c18b-46c3-b837-6c6565f9ee9e" ;
