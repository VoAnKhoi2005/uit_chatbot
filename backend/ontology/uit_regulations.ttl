    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Khoản 2" .

uit:khoan_4ef63c55_3ae5_4b1d_919e_2d743ef4350a a uit:Clause ;
    rdfs:label "Khoản 5" ;
    uit:clauseId "4ef63c55-3ae5-4b1d-919e-2d743ef4350a" ;
    uit:docId "c9cbb5b3-7c97-4baf-b5ce-6803d6ef5f3a" ;
    uit:docTitle "507-Qd-Dhcntt-27-5-2024 Quy Che Dao Tao Cho Sinh Vien" ;
    uit:fullText """Hiệu trưởng tổ chức xây dựng, thẩm định và phê duyệt học liệu ĐTTX trước khi thực
hiện ĐTTX theo các quy định của Trường về việc biên soạn, lựa chọn, thẩm định, duyệt
và sử dụng tài liệu giảng dạy, giáo trình giáo dục đại học. Trường định kỳ tổ chức rà
soát, đánh giá và cập nhật học liệu đáp ứng yêu cầu về chuyên môn và kỹ thuật.""" ;
    uit:hasParent uit:dieu_a014ba42_40a0_4a83_8093_71fb31f58e31 ;
