uit:khoan_624368d7_4660_47b7_afe2_cb51b91511f5 a uit:Clause ;
    rdfs:label "Khoản 6" ;
    uit:clauseId "624368d7-4660-47b7-afe2-cb51b91511f5" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Khi sinh viên đư ợc chuy ển từ chương trình chính quy c ủa Trư ờng sang chương trình đào 
tạo từ xa của Trư ờng thì đư ợc công nh ận chuy ển đổi tối đa số tín ch ỉ theo nguyên t ắc tại 
Khoản 3 của điều này.""" ;
    uit:hasParent uit:dieu_8c3102af_5850_4962_80a6_94743cdb515d ;
