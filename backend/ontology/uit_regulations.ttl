uit:dieu_a2d29b8e_0050_4e62_824f_471c3fcfba4e a uit:Article ;
    rdfs:label "Điều 13" ;
    uit:articleId "a2d29b8e-0050-4e62-824f-471c3fcfba4e" ;
    uit:docId "e078682d-57d3-420b-924b-5411aee851f3" ;
    uit:docTitle "128-Qd-Dhcntt-Dtdh 30-8-2016 Ban Hanh Qd Day Va Hoc Nn Doi Voi He Dai Hoc Cq Cua Truong Dhcntt Khoa 2016" ;
    uit:fullText """1. Quản lý đào tạo ngoại ngữ theo chương trình giảng dạy của trường.
2. Chủ trì tổ chức thi xếp lớp đầu khóa.
3. Chủ trì tổ chức xét miễn học.
4. Quản lý việc thực hiện quy định này.""" ;
    uit:hasClause uit:khoan_0c880e04_3e66_49fa_be10_e9e7fada2ba2,
        uit:khoan_96445e23_ee43_4cc6_8dcb_410d6e76d218,
        uit:khoan_ab898d18_73c7_458e_8c49_0f9544d906ee,
        uit:khoan_c1db07b3_0697_4aba_8ac9_767a211ce7a5 ;
    uit:hasParent uit:chuong_3da2c57b_e8c0_4891_838e_b63ab896d828 ;
    uit:heading "Trách nhiệm của Phòng Đào tạo Đại học" ;
    uit:inDocument uit:Document_e078682d_57d3_420b_924b_5411aee851f3 ;
