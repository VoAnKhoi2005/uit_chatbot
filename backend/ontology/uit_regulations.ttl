    uit:title "Khoản 7" .

uit:khoan_df3115d8_04fa_499d_b745_f4cce32fe7ed a uit:Clause ;
    rdfs:label "Khoản 2" ;
    uit:clauseId "df3115d8-04fa-499d-b745-f4cce32fe7ed" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Sau khi tốt nghiệp, sinh viên được cấp một bảng điểm kèm theo bằng tốt nghiệp.
Trang 23/27""" ;
    uit:hasParent uit:dieu_5670d6f6_49f4_42fb_b563_3c2214452195 ;
