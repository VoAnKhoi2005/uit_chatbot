    uit:fullText """Sinh viên tạm dừng học tập, khi muốn trở lại học tiếp tại Trường phải hoàn tất thủ tục
nhập học theo quy định của Trường.""" ;
    uit:hasParent uit:dieu_f07f372e_a760_45df_9c1d_f0e7f166c36b ;
