uit:diem_5b69aed0_1d8d_43a0_bfb4_21cee4675424 a uit:Entity ;
    rdfs:label "Điểm b)" ;
    uit:docId "c9cbb5b3-7c97-4baf-b5ce-6803d6ef5f3a" ;
    uit:docTitle "507-Qd-Dhcntt-27-5-2024 Quy Che Dao Tao Cho Sinh Vien" ;
    uit:fullText """Thời gian đào tạo chương trình văn bằng thứ nhất, chương trình văn bằng thứ hai,
chương trình liên thông đại học được xác định trên cơ sở học phần và khối lượng tích
lũy quy định cho từng chương trình;""" ;
    uit:hasParent uit:khoan_153a8b66_4c01_4b8f_9efe_ec40ad254763 ;
    uit:inDocument uit:Document_c9cbb5b3_7c97_4baf_b5ce_6803d6ef5f3a ;
    uit:level "diem" ;
    uit:ordinal 1.000102e+04 ;
    uit:path "2/10/1/b" ;
    uit:soHieu "507/QD/DHCNTT/27/5/2024" ;
    uit:title "Điểm b)" .

uit:diem_5cf2460b_d2f1_406a_bf4e_6943036111fb a uit:Entity ;
    rdfs:label "Điểm c)" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Trích lục hoặc quyết định thay đổi hoặc cải chính hộ tịch, xác định lại dân tộc, xác
định lại giới tính đối với trường hợp chỉnh sửa văn bằng, chứng chỉ do thay đổi hoặc cải chính
hộ tịch, xác định lại dân tộc, xác định lại giới tính;""" ;
    uit:hasParent uit:khoan_f5c8033d_4ef1_4605_9045_dacd5ed4e89a ;
    uit:inDocument uit:Document_b61c9fab_9889_48b7_b2c5_8d7fb72f4110 ;
