uit:khoan_4ab248c9_3d00_47ff_97eb_cf5ef27d252b a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "4ab248c9-3d00-47ff-97eb-cf5ef27d252b" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """Sau khi được xét trúng tuyển vào Trường, do một số hoàn cảnh đặc biệt như được điều
động vào các lực lượng vũ trang, thai sản, bệnh tật, tai nạn, hoàn cảnh khó khăn xảy ra đột
xuất, thí sinh trúng tuyển có thể xin bảo lưu kết quả. Thí sinh trúng tuyển phải nộp đơn xin
bảo lưu chậm nhất 15 ngày kể từ ngày gọi nhập học cho P. ĐTĐH của Trường và chỉ được
bảo lưu khi có quyết định chấp thuận của Hiệu trưởng.
Thời gian bảo lưu kết quả trúng tuyển không quá 01 năm. Đối với trường hợp được
điều động vào các lực lượng vũ trang thì thời gian bảo lưu kết quả trúng tuyển bằng với thời
Trang 12/27
gian được điều động. Muốn nhập học lại, thí sinh phải làm đơn xin nhập học và nộp P.
ĐTĐH của Trường trước khi bắt đầu học kỳ ít nhất 1 tháng để được giải quyết.""" ;
    uit:hasParent uit:dieu_423fb7aa_47aa_44f2_8b04_697e538e37c1 ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
