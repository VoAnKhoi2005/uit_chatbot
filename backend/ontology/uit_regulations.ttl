    uit:docTitle "507-Qd-Dhcntt-27-5-2024 Quy Che Dao Tao Cho Sinh Vien" ;
    uit:fullText "Phạm vi điều chỉnh và đối tượng áp dụng ....................................................................... 4" ;
    uit:hasParent uit:dieu_b1652e7a_0ab1_4fc9_b3cf_45197da39f59 ;
