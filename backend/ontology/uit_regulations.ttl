uit:khoan_2c5be7b1_75fd_4356_ae91_380fb3971572 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "2c5be7b1-75fd-4356-ae91-380fb3971572" ;
    uit:docId "b61c9fab-9889-48b7-b2c5-8d7fb72f4110" ;
    uit:docTitle "172-Qd-Dhcntt 08-3-2023 Quy Che Van Bang Chung Chi" ;
    uit:fullText """Hiệu trưởng hoặc thủ trưởng đơn vị được ủy quyền cấp chứng chỉ phải ký theo mẫu
chữ ký đã đăng ký với cơ quan có thẩm quyền và ghi rõ, đủ họ tên, chức danh.""" ;
    uit:hasParent uit:dieu_a404e188_1644_49bd_baad_07c742b50e86 ;
    uit:inDocument uit:Document_b61c9fab_9889_48b7_b2c5_8d7fb72f4110 ;
