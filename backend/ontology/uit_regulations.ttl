    uit:ordinal 32001 ;
    uit:path "6/32/1" ;
    uit:soHieu "172/QD/DHCNTT" ;
    uit:title "Khoản 1" .

uit:khoan_621ad716_db30_4499_9691_e437a69748c3 a uit:Clause ;
