    uit:ordinal 11001 ;
    uit:path "1/45/1" ;
    uit:soHieu "790/QĐ-ĐHCNTT" ;
    uit:title "Khoản 1" .

uit:khoan_e58b6d89_d8ff_4e12_909d_abd850824a72 a uit:Clause ;
