uit:khoan_dd86052d_5b9a_43e6_afd0_b4c25bf0a355 a uit:Clause ;
    rdfs:label "Khoản 3" ;
    uit:clauseId "dd86052d-5b9a-43e6-afd0-b4c25bf0a355" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText """Tổ chức
chấm phúc
khảo
P.ĐTĐH/
VPĐB
18
3
Chấm
phúc
khảo
– Khoa phân công cán
bộ xem xét bài thi.
– Danh sách phúc khảo
phải có đầy đủ chữ ký
cán bộ chấm và Khoa
duyệt, ghi rõ lý do nếu
có sự khác biệt điểm
trước và sau khi phúc
khảo.
– Khoa chuyển phiếu
phúc khảo sau khi chấm
cho P.ĐTĐH/ VPĐB.
t+17
Khoa,
Cán bộ
chấm
phúc
khảo
P.ĐTĐ
H/
VPĐB
– Danh
sách phúc
khảo điểm
4
Công bố
kết quả
phúc
khảo
P.ĐTĐH/VPĐB cập nhật
điểm vào hệ thống quản
lý điểm và công bố kết
quả cho SV. SV sẽ nhận
được email thông báo
kết quả phúc khảo.
t+20
P.ĐTĐH
/ VPĐB
5
Lưu trữ
hồ sơ
phúc
khảo
– Lưu trữ hồ sơ phúc
khảo vào bộ hồ sơ thi
của đợt thi.
t+30
P.ĐTĐH
/ VPĐB""" ;
    uit:hasParent uit:dieu_b1dbf3bc_263d_4313_a6b0_9b60e551c182 ;
