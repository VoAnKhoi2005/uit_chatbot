uit:dieu_c12995b6_7bfe_4cbc_b557_38a2ced46f68 a uit:Article ;
    rdfs:label "Điều 3" ;
    uit:articleId "c12995b6-7bfe-4cbc-b557-38a2ced46f68" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText """Phòng Thanh tra Pháp chế và Đảm bảo Chất lượng có trách nhiệm tổ chức thanh tra, kiểm
tra và giám sát công tác tổ chức thi.""" ;
