uit:khoan_967df5bf_e52d_4b88_8949_218735736db6 a uit:Clause ;
    rdfs:label "Khoản 9" ;
    uit:clauseId "967df5bf-e52d-4b88-8949-218735736db6" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText """Khi hết giờ làm bài, CBCT yêu cầu SV ngừng làm bài và thu bài của tất cả SV, kể cả
SV đã bị xử lý vi phạm. Một CBCT duy trì trật tự và kỷ luật phòng thi. Một CBCT vừa gọi
tên từng SV lên nộp bài, vừa nhận bài thi của SV. Khi nhận bài phải đếm đủ số tờ giấy thi của
SV đã nộp, yêu cầu SV tự ghi đúng số tờ và ký tên vào danh sách. CBCT tuyệt đối không tự
ý thêm tên và cho SV ký thêm vào danh sách thi.""" ;
    uit:hasParent uit:dieu_894561d9_bc4e_4fd3_8cdd_412a0efc193b ;
    uit:inDocument uit:Document_0cf30b50_fd07_4dc5_96fe_4b701c1e54ec ;
    uit:level "khoan" ;
    uit:ordinal 12009 ;
    uit:path "2/12/9" ;
    uit:soHieu "1139" ;
    uit:title "Khoản 9" .

uit:khoan_96cd5fd2_c477_4799_acc7_efc9c0ce34c2 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "96cd5fd2-c477-4799-acc7-efc9c0ce34c2" ;
    uit:docId "e4f0b05e-6ed8-47a8-b1d0-7722507d7b1f" ;
    uit:docTitle "159-Qd-Dhcntt 05-03-2024 Ban Hanh Quy Dinh Kltn" ;
    uit:fullText """Trong trường hợp có tranh chấp, khiếu nại về kết quả chấm bảo vệ KLTN, Hiệu trưởng
có thể chỉ định một Hội đồng để chấm phúc tra. Thành phần, nhiệm vụ, quyền hạn của Hội
đồng phúc tra được Hiệu trưởng quy định trong quyết định thành lập Hội đồng. Điểm cuối
cùng của KLTN là điểm của Hội đồng chấm phúc tra.""" ;
    uit:hasParent uit:dieu_a75caa1b_efb5_411e_931e_0ca733c9487c ;
    uit:inDocument uit:Document_e4f0b05e_6ed8_47a8_b1d0_7722507d7b1f ;
    uit:level "khoan" ;
    uit:ordinal 14001 ;
    uit:path "3/14/1" ;
    uit:soHieu "159/QD/DHCNTT" ;
    uit:title "Khoản 1" .

uit:khoan_975803d3_35b5_4b2f_8f78_caa1038302c7 a uit:Clause ;
    rdfs:label "Khoản 5" ;
    uit:clauseId "975803d3-35b5-4b2f-8f78-caa1038302c7" ;
    uit:docId "bf37de67-90ea-454e-b7e1-2d54fc74c8cc" ;
    uit:docTitle "Quy chế đào tạo theo học chế tín chỉ cho hệ đại học chính quy của Trường Đại học Công nghệ Thông tin" ;
    uit:fullText """T ổng số tín ch ỉ chương trình đào t ạo chính quy của các cơ s ở đào t ạo ngoài trư ờng được 
công nh ận và chuy ển đổi không vư ợt quá 50% tổng số tín ch ỉ chương trình đào tạo của 
trường. 
Trang 22/27""" ;
    uit:hasParent uit:dieu_8c3102af_5850_4962_80a6_94743cdb515d ;
    uit:inDocument uit:Document_bf37de67_90ea_454e_b7e1_2d54fc74c8cc ;
