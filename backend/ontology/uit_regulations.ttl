uit:khoan_9865895c_75fb_4a6b_9407_fa1ecb444de8 a uit:Clause ;
    rdfs:label "Khoản 1" ;
    uit:clauseId "9865895c-75fb-4a6b-9407-fa1ecb444de8" ;
    uit:docId "c9cbb5b3-7c97-4baf-b5ce-6803d6ef5f3a" ;
    uit:docTitle "507-Qd-Dhcntt-27-5-2024 Quy Che Dao Tao Cho Sinh Vien" ;
    uit:fullText """Trước ngày 31 tháng 12 hàng năm, TTPTCNTT gửi báo cáo cho Hiệu trưởng thông
qua P.ĐTĐH bao gồm: Tuyển sinh; quy mô đào tạo; tổ chức đào tạo; cấp bằng tốt nghiệp
trong năm; và dự kiến kế hoạch tuyển sinh năm sau. Nội dung báo cáo phải có đánh giá
các hoạt động ĐTTX của TTPTCNTT và đề xuất giải pháp để củng cố, phát triển ĐTTX.""" ;
    uit:hasParent uit:dieu_e4d2f1eb_c18e_4e1d_97a4_422b1544cc94 ;
    uit:inDocument uit:Document_c9cbb5b3_7c97_4baf_b5ce_6803d6ef5f3a ;
    uit:level "khoan" ;
    uit:ordinal 25001 ;
    uit:path "4/25/1" ;
    uit:soHieu "507/QD/DHCNTT/27/5/2024" ;
    uit:title "Khoản 1" .

uit:khoan_996ddce5_3d86_4d14_bcda_a6e0fabb62e1 a uit:Clause ;
    rdfs:label "Khoản 4" ;
    uit:clauseId "996ddce5-3d86-4d14-bcda-a6e0fabb62e1" ;
    uit:docId "0cf30b50-fd07-4dc5-96fe-4b701c1e54ec" ;
    uit:docTitle "1139 Qd-Dhcntt 20-12-2022 To Chuc Thi Cac Mon Hoc He Dai Hoc Chinh Quy" ;
    uit:fullText """Khi bắt đầu giờ mở đề, 1 CBCT giơ cao phong bì đề thi để SV thấy rõ cả mặt trước và
mặt sau còn nguyên nhãn niêm phong, mời 1 đại diện SV ký tên xác nhận tình trạng niêm
phong lên nhãn của túi đề thi; bóc phong bì đựng đề thi và phát đề thi cho từng SV (trước khi
phát đề thi cần kiểm tra số lượng đề thi, nếu thiếu hoặc lẫn đề khác, cần báo ngay cho cán bộ
trực thi của đơn vị tổ chức thi xử lý). Khi sinh viên cuối cùng nhận được đề thi, CBCT cho
phép sinh viên lật đề thi lên và yêu cầu sinh viên kiểm tra tình trạng đề thi trước khi làm bài.
Nếu có bất kỳ vấn đề gì về đề thi, CBCT cần báo ngay cho cán bộ trực thi của đơn vị tổ chức
thi xử lý. CBCT phải phát đề thi đúng giờ qui định bắt đầu ca thi.""" ;
    uit:hasParent uit:dieu_894561d9_bc4e_4fd3_8cdd_412a0efc193b ;
    uit:inDocument uit:Document_0cf30b50_fd07_4dc5_96fe_4b701c1e54ec ;
    uit:level "khoan" ;
    uit:ordinal 12004 ;
    uit:path "2/12/4" ;
    uit:soHieu "1139" ;
    uit:title "Khoản 4" .

